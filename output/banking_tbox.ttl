    ns1:decisionProbability 9.75e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 1.917e+00 ;
    rdf:object ns1:PaymentInstrument ;
    rdf:predicate rdfs:subClassOf ;
