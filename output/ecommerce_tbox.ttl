@prefix ns1: <http://example.org/ecommerce#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:AudioAlbum a owl:Class ;
    rdfs:label "AudioAlbum" .

ns1:Buyer a owl:Class ;
    rdfs:label "Buyer" ;
    owl:disjointWith ns1:ReviewTierA .

ns1:DiscountPercentagePromotion a owl:Class ;
    rdfs:label "DiscountPercentagePromotion" ;
    ns1:competencyQuestion "What discount percentage is associated with a specific promotion title and coupon code?" ;
    rdfs:comment "PromotionDetails represents the details of a promotional offer, including its discount percentage, title, and associated coupon code." .

ns1:DomesticSupplier a owl:Class ;
    rdfs:label "DomesticSupplier" .

ns1:EBook a owl:Class ;
    rdfs:label "EBook" ;
    owl:disjointWith ns1:ReviewTierB,
        ns1:Shipmenttrackinginfo,
        ns1:SoftwareProduct .

ns1:Ontology a owl:Ontology ;
    rdfs:label "Core induced ontology (v3.0 Clef-Flash)" ;
    prov:wasAttributedTo "clef-flash:latest" .

ns1:ReviewTierC a owl:Class ;
    rdfs:label "ReviewTierC" .

ns1:Shipmenttracking a owl:Class ;
    rdfs:label "Shipmenttracking" ;
    ns1:competencyQuestion "What is the tracking number and shipping status of a shipment, and which carrier is being used for the shipping process?" ;
    rdfs:comment "ShipmentTracking represents the core information related to a shipment's tracking number, shipping status, and carrier." .

ns1:VerifiedSupplier a owl:Class ;
    rdfs:label "VerifiedSupplier" .

ns1:accountIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "accountIdentifier" ;
    rdfs:domain ns1:Purchaser .

ns1:couponCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "couponCode" .

ns1:crossPromotedWith a owl:ObjectProperty ;
    rdfs:label "crossPromotedWith" ;
    rdfs:domain ns1:ProductCategory ;
    rdfs:range ns1:ProductCategory .

ns1:customerName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "customerName" ;
    rdfs:domain ns1:Customer .

ns1:dimensionMeasurement a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dimensionMeasurement" ;
    rdfs:domain ns1:Productspecification .

ns1:discountPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "discountPercentage" .

ns1:downloadUrl a owl:DatatypeProperty ;
    rdfs:label "downloadUrl" ;
    rdfs:domain ns1:MobileApp .

ns1:inStockUnits a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "inStockUnits" ;
    rdfs:domain ns1:ConsumerElectronics .

ns1:isSubCategoryOf a owl:ObjectProperty ;
    rdfs:label "isSubCategoryOf" ;
    rdfs:domain ns1:ProductCategory ;
    rdfs:range ns1:ProductCategory .

ns1:orderTotalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "orderTotalAmount" ;
    rdfs:domain ns1:Order .

ns1:primaryEmail a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "primaryEmail" ;
    rdfs:domain ns1:Customer .

ns1:productTitle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "productTitle" ;
    rdfs:domain ns1:Product .

ns1:promotionTitle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "promotionTitle" .

ns1:reviewRating a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reviewRating" ;
    rdfs:domain ns1:ProductReview .

ns1:reviewText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reviewText" ;
    rdfs:domain ns1:ProductReview .

ns1:shippingCarrier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "shippingCarrier" .

ns1:shippingStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "shippingStatus" .

ns1:skuCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "skuCode" ;
    rdfs:domain ns1:PhysicalProduct .

ns1:supplierName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "supplierName" ;
    rdfs:domain ns1:Supplier .

ns1:technicalWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "technicalWeight" ;
    rdfs:domain ns1:Productspecification .

ns1:trackingCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "trackingCode" ;
    rdfs:domain ns1:Order .

ns1:trackingNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "trackingNumber" .

ns1:unitPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "unitPrice" ;
    rdfs:domain ns1:Product .

ns1:warrantyPeriod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "warrantyPeriod" ;
    rdfs:domain ns1:Productspecification .

ns1:DigitalMedia a owl:Class ;
    rdfs:label "DigitalMedia" ;
    owl:disjointWith ns1:ReviewTierA .

ns1:DigitalProduct a owl:Class ;
    rdfs:label "DigitalProduct" .

ns1:MobileApp a owl:Class ;
    rdfs:label "MobileApp" .

ns1:Party a owl:Class ;
    rdfs:label "Party" ;
    owl:disjointWith ns1:ReviewTierB,
        ns1:Shipmenttrackinginfo .

ns1:hasSpecification a owl:ObjectProperty ;
    rdfs:label "hasSpecification" ;
    rdfs:domain ns1:Smartphone ;
    rdfs:range ns1:Productspecification .

ns1:Footwear a owl:Class ;
    rdfs:label "Footwear" ;
    rdfs:subClassOf ns1:PhysicalProduct ;
    owl:disjointWith ns1:Laptop .

ns1:InternationalSupplier a owl:Class ;
    rdfs:label "InternationalSupplier" ;
    rdfs:subClassOf ns1:Supplier .

ns1:OperatingSystem a owl:Class ;
    rdfs:label "OperatingSystem" ;
    rdfs:subClassOf ns1:SoftwareProduct .

ns1:PlatinumVIPCustomer a owl:Class ;
    rdfs:label "PlatinumVIPCustomer" ;
    rdfs:subClassOf ns1:VIPCustomer .

ns1:Purchaser a owl:Class ;
    rdfs:label "Purchaser" .

ns1:ReviewTierA a owl:Class ;
    rdfs:label "ReviewTierA" .

ns1:appliedPromotion a owl:ObjectProperty ;
    rdfs:label "appliedPromotion" ;
    rdfs:domain ns1:Order ;
    rdfs:range ns1:Discountapplication .

ns1:orderHasShipment a owl:ObjectProperty ;
    rdfs:label "orderHasShipment" ;
    rdfs:domain ns1:Order ;
    rdfs:range ns1:Shipmenttrackinginfo .

ns1:Outerwear a owl:Class ;
    rdfs:label "Outerwear" ;
    rdfs:subClassOf ns1:PhysicalProduct .

ns1:ProductReview a owl:Class ;
    rdfs:label "ProductReview" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview linked via reviewsProduct has only fillers of type Laptop" ;
            owl:allValuesFrom ns1:Laptop ;
            owl:onProperty ns1:reviewsProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview is linked via reviewsProduct to at least one instance of Laptop" ;
            owl:onProperty ns1:reviewsProduct ;
            owl:someValuesFrom ns1:Laptop ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview is linked via reviewsProduct to at least one instance of PhysicalProduct" ;
            owl:onProperty ns1:reviewsProduct ;
            owl:someValuesFrom ns1:PhysicalProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview linked via reviewsProduct has only fillers of type ConsumerElectronics" ;
            owl:allValuesFrom ns1:ConsumerElectronics ;
            owl:onProperty ns1:reviewsProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview linked via reviewsProduct has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:reviewsProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of ProductReview is linked via reviewsProduct to at least one instance of ConsumerElectronics" ;
            owl:onProperty ns1:reviewsProduct ;
            owl:someValuesFrom ns1:ConsumerElectronics ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.33e-01 ;
            rdfs:comment "Every instance of ProductReview is linked via reviewsProduct to at least one instance of Product" ;
            owl:onProperty ns1:reviewsProduct ;
            owl:someValuesFrom ns1:Product ] ;
    owl:disjointWith ns1:Shipmenttrackinginfo .

ns1:ReviewTierB a owl:Class ;
    rdfs:label "ReviewTierB" .

ns1:Apparel a owl:Class ;
    rdfs:label "Apparel" ;
    rdfs:subClassOf ns1:PhysicalProduct .

ns1:Customer a owl:Class ;
    rdfs:label "Customer" ;
    owl:disjointWith ns1:DigitalMedia,
        ns1:DigitalProduct,
        ns1:Discountapplication .

ns1:Discountapplication a owl:Class ;
    rdfs:label "Discountapplication" ;
    ns1:competencyQuestion "What specific promotion details are required to apply a discount to a product or service?" ;
    rdfs:comment "PromotionDetails represents the essential attributes and conditions for a promotional offer." ;
    owl:disjointWith ns1:ReviewTierB .

ns1:ProductCategory a owl:Class ;
    rdfs:label "ProductCategory" ;
    owl:disjointWith ns1:Purchaser .

ns1:RegisteredCustomer a owl:Class ;
    rdfs:label "RegisteredCustomer" .

ns1:SoftwareProduct a owl:Class ;
    rdfs:label "SoftwareProduct" .

ns1:Supplier a owl:Class ;
    rdfs:label "Supplier" .

ns1:placedByCustomer a owl:ObjectProperty ;
    rdfs:label "placedByCustomer" ;
    rdfs:domain ns1:Order ;
    rdfs:subPropertyOf ns1:primaryContactCustomer .

ns1:Productspecification a owl:Class ;
    rdfs:label "Productspecification" ;
    ns1:competencyQuestion "What are the specifications of a product, including its warranty period, dimensions, weight, and any related technical details?" ;
    rdfs:comment "ProductSpecification captures the detailed attributes of a product, including its warranty period, dimensions, weight, and other technical details." .

ns1:VIPCustomer a owl:Class ;
    rdfs:label "VIPCustomer" ;
    rdfs:subClassOf ns1:RegisteredCustomer .

ns1:Shipmenttrackinginfo a owl:Class ;
    rdfs:label "Shipmenttrackinginfo" ;
    ns1:competencyQuestion "What is the tracking number and current shipping status of a shipment, and which carrier is responsible for its delivery, given that the shipment is associated with an order?" ;
    rdfs:comment "ShipmentTrackingInfo captures the details of a shipment, including its tracking number, shipping status, and carrier, in relation to an order." .

ns1:Smartphone a owl:Class ;
    rdfs:label "Smartphone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 9.18e-01 ;
            rdfs:comment "Every instance of Smartphone is linked via hasSpecification to at least one instance of Productspecification" ;
            owl:onProperty ns1:hasSpecification ;
            owl:someValuesFrom ns1:Productspecification ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Smartphone linked via frequentlyBoughtTogether has only fillers of type Apparel" ;
            owl:allValuesFrom ns1:Apparel ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Smartphone linked via frequentlyBoughtTogether has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Smartphone linked via frequentlyBoughtTogether has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        ns1:ConsumerElectronics .

ns1:primaryContactCustomer a owl:ObjectProperty ;
    rdfs:label "primaryContactCustomer" ;
    rdfs:domain ns1:Order ;
    rdfs:subPropertyOf ns1:placedByCustomer .

ns1:recommendedWith a owl:ObjectProperty ;
    rdfs:label "recommendedWith" ;
    rdfs:domain ns1:PhysicalProduct ;
    rdfs:range ns1:ConsumerElectronics .

ns1:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order linked via includesProduct has only fillers of type Smartphone" ;
            owl:allValuesFrom ns1:Smartphone ;
            owl:onProperty ns1:includesProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of Order is linked via primaryContactCustomer to at least one instance of Party" ;
            owl:onProperty ns1:primaryContactCustomer ;
            owl:someValuesFrom ns1:Party ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of Order is linked via primaryContactCustomer to at least one instance of RegisteredCustomer" ;
            owl:onProperty ns1:primaryContactCustomer ;
            owl:someValuesFrom ns1:RegisteredCustomer ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order is linked via includesProduct to at least one instance of PhysicalProduct" ;
            owl:onProperty ns1:includesProduct ;
            owl:someValuesFrom ns1:PhysicalProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order is linked via includesProduct to at least one instance of Product" ;
            owl:onProperty ns1:includesProduct ;
            owl:someValuesFrom ns1:Product ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order linked via includesProduct has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:includesProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order is linked via includesProduct to at least one instance of Smartphone" ;
            owl:onProperty ns1:includesProduct ;
            owl:someValuesFrom ns1:Smartphone ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.77e-01 ;
            rdfs:comment "Every instance of Order is linked via includesProduct to at least one instance of ConsumerElectronics" ;
            owl:onProperty ns1:includesProduct ;
            owl:someValuesFrom ns1:ConsumerElectronics ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.98e-01 ;
            rdfs:comment "Every instance of Order is linked via primaryContactCustomer to at least one instance of Customer" ;
            owl:onProperty ns1:primaryContactCustomer ;
            owl:someValuesFrom ns1:Customer ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of Order linked via includesProduct has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:includesProduct ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.98e-01 ;
            rdfs:comment "Every instance of Order linked via orderHasShipment has only fillers of type Shipmenttrackinginfo" ;
            owl:allValuesFrom ns1:Shipmenttrackinginfo ;
            owl:onProperty ns1:orderHasShipment ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.98e-01 ;
            rdfs:comment "Every instance of Order is linked via orderHasShipment to at least one instance of Shipmenttrackinginfo" ;
            owl:onProperty ns1:orderHasShipment ;
            owl:someValuesFrom ns1:Shipmenttrackinginfo ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.98e-01 ;
            rdfs:comment "Every instance of Order is linked via appliedPromotion to at least one instance of Discountapplication" ;
            owl:onProperty ns1:appliedPromotion ;
            owl:someValuesFrom ns1:Discountapplication ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of Order is linked via placedByCustomer to at least one instance of Customer" ;
            owl:onProperty ns1:placedByCustomer ;
            owl:someValuesFrom ns1:Customer ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.98e-01 ;
            rdfs:comment "Every instance of Order linked via appliedPromotion has only fillers of type Discountapplication" ;
            owl:allValuesFrom ns1:Discountapplication ;
            owl:onProperty ns1:appliedPromotion ] .

ns1:includesProduct a owl:ObjectProperty ;
    rdfs:label "includesProduct" ;
    rdfs:domain ns1:Order ;
    rdfs:range ns1:Smartphone .

ns1:reviewsProduct a owl:ObjectProperty ;
    rdfs:label "reviewsProduct" ;
    rdfs:domain ns1:ProductReview ;
    rdfs:range ns1:Laptop .

ns1:Laptop a owl:Class ;
    rdfs:label "Laptop" ;
    rdfs:subClassOf ns1:ConsumerElectronics,
        ns1:PhysicalProduct ;
    owl:disjointWith ns1:Outerwear .

ns1:frequentlyBoughtTogether a owl:ObjectProperty ;
    rdfs:label "frequentlyBoughtTogether" ;
    rdfs:domain ns1:PhysicalProduct ;
    rdfs:range ns1:PhysicalProduct .

ns1:ConsumerElectronics a owl:Class ;
    rdfs:label "ConsumerElectronics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ConsumerElectronics linked via frequentlyBoughtTogether has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ConsumerElectronics linked via frequentlyBoughtTogether has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ConsumerElectronics linked via frequentlyBoughtTogether has only fillers of type Apparel" ;
            owl:allValuesFrom ns1:Apparel ;
            owl:onProperty ns1:frequentlyBoughtTogether ] .

ns1:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Product linked via recommendedWith has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:recommendedWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Product linked via frequentlyBoughtTogether has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Product linked via recommendedWith has only fillers of type ConsumerElectronics" ;
            owl:allValuesFrom ns1:ConsumerElectronics ;
            owl:onProperty ns1:recommendedWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Product linked via recommendedWith has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:recommendedWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Product linked via frequentlyBoughtTogether has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:frequentlyBoughtTogether ] .

ns1:PhysicalProduct a owl:Class ;
    rdfs:label "PhysicalProduct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalProduct linked via frequentlyBoughtTogether has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalProduct linked via recommendedWith has only fillers of type PhysicalProduct" ;
            owl:allValuesFrom ns1:PhysicalProduct ;
            owl:onProperty ns1:recommendedWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalProduct linked via recommendedWith has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:recommendedWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalProduct linked via frequentlyBoughtTogether has only fillers of type Product" ;
            owl:allValuesFrom ns1:Product ;
            owl:onProperty ns1:frequentlyBoughtTogether ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalProduct linked via recommendedWith has only fillers of type ConsumerElectronics" ;
            owl:allValuesFrom ns1:ConsumerElectronics ;
            owl:onProperty ns1:recommendedWith ],
        ns1:Product .

[] a rdf:Statement,
        owl:Axiom ;
    ns1:aboxSupportCount 12 ;
    ns1:confidenceScore 8.73e-01 ;
    ns1:decisionProbability 9e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 1.89e+00 ;
    rdf:object ns1:PhysicalProduct ;
    rdf:predicate rdfs:subClassOf ;
    rdf:subject ns1:Apparel ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ns1:Apparel ;
    owl:annotatedTarget ns1:PhysicalProduct ;
    prov:wasAttributedTo "clef-flash:latest" .

