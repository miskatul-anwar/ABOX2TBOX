@prefix : <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:SmartcityInducedOntology a owl:Ontology ;
    rdfs:label "Smartcity Domain Ontology"^^xsd:string .

:batteryLevelPercentage a owl:DatatypeProperty ;
    rdfs:label "batteryLevelPercentage"^^xsd:string .

:communicatesMeshWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "communicatesMeshWith"^^xsd:string ;
    rdfs:domain :EnvironmentalSensor ;
    rdfs:range :EnvironmentalSensor .

:connectorStandard a owl:DatatypeProperty ;
    rdfs:label "connectorStandard"^^xsd:string .

:coolingSystemType a owl:DatatypeProperty ;
    rdfs:label "coolingSystemType"^^xsd:string .

:cycleTimeSeconds a owl:DatatypeProperty ;
    rdfs:label "cycleTimeSeconds"^^xsd:string .

:deviceName a owl:DatatypeProperty ;
    rdfs:label "deviceName"^^xsd:string .

:deviceSerialIdentifier a owl:DatatypeProperty ;
    rdfs:label "deviceSerialIdentifier"^^xsd:string .

:facilityIdentifier a owl:DatatypeProperty ;
    rdfs:label "facilityIdentifier"^^xsd:string .

:firmwareVersion a owl:DatatypeProperty ;
    rdfs:label "firmwareVersion"^^xsd:string .

:fleetNumber a owl:DatatypeProperty ;
    rdfs:label "fleetNumber"^^xsd:string .

:flightCeilingMeters a owl:DatatypeProperty ;
    rdfs:label "flightCeilingMeters"^^xsd:string .

:frequencyBandsGHz a owl:DatatypeProperty ;
    rdfs:label "frequencyBandsGHz"^^xsd:string .

:generatesTelemetryRecord a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "generatesTelemetryRecord"^^xsd:string ;
    rdfs:domain :AirQualitySensor ;
    rdfs:range :TelemetrySignal .

:hasChargingInterface a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasChargingInterface"^^xsd:string ;
    rdfs:domain :DistributionSubstation ;
    rdfs:range :ConnectorStandard .

:hasMaintenanceRecord a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasMaintenanceRecord"^^xsd:string ;
    rdfs:domain :ActuatorDevice ;
    rdfs:range :TechnicianNotes .

:inferenceLatencyMs a owl:DatatypeProperty ;
    rdfs:label "inferenceLatencyMs"^^xsd:string .

:installedInZone a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "installedInZone"^^xsd:string ;
    rdfs:domain :PhysicalDevice ;
    rdfs:range :UrbanZone .

:loopSensitivity a owl:DatatypeProperty ;
    rdfs:label "loopSensitivity"^^xsd:string .

:lumensOutput a owl:DatatypeProperty ;
    rdfs:label "lumensOutput"^^xsd:string .

:maximumChargeKW a owl:DatatypeProperty ;
    rdfs:label "maximumChargeKW"^^xsd:string .

:partOfGridSegment a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "partOfGridSegment"^^xsd:string ;
    rdfs:domain :GridSegment ;
    rdfs:range :GridSegment .

:passengerCapacity a owl:DatatypeProperty ;
    rdfs:label "passengerCapacity"^^xsd:string .

:ratedPowerKW a owl:DatatypeProperty ;
    rdfs:label "ratedPowerKW"^^xsd:string .

:relaysDataTo a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "relaysDataTo"^^xsd:string ;
    rdfs:domain :GridSegment ;
    rdfs:range :GridSegment .

:sensorPrecisionScore a owl:DatatypeProperty ;
    rdfs:label "sensorPrecisionScore"^^xsd:string .

:serviceEndpoint a owl:DatatypeProperty ;
    rdfs:label "serviceEndpoint"^^xsd:string .

:sharesPowerBusWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "sharesPowerBusWith"^^xsd:string ;
    rdfs:domain :GridInfrastructure ;
    rdfs:range :GridInfrastructure .

:signalStrengthDbm a owl:DatatypeProperty ;
    rdfs:label "signalStrengthDbm"^^xsd:string .

:storageCapacityMWh a owl:DatatypeProperty ;
    rdfs:label "storageCapacityMWh"^^xsd:string .

:technicianNotes a owl:DatatypeProperty ;
    rdfs:label "technicianNotes"^^xsd:string .

:telemetryPacketId a owl:DatatypeProperty ;
    rdfs:label "telemetryPacketId"^^xsd:string .

:transmissionStatus a owl:DatatypeProperty ;
    rdfs:label "transmissionStatus"^^xsd:string .

:urgencyPriorityScore a owl:DatatypeProperty ;
    rdfs:label "urgencyPriorityScore"^^xsd:string .

:voltageRatingKV a owl:DatatypeProperty ;
    rdfs:label "voltageRatingKV"^^xsd:string .

:workOrderCode a owl:DatatypeProperty ;
    rdfs:label "workOrderCode"^^xsd:string .

:AcousticNoiseSensor a owl:Class ;
    rdfs:label "AcousticNoiseSensor"^^xsd:string ;
    rdfs:subClassOf :EnvironmentalSensor ;
    owl:disjointWith :ActuatorDevice,
        :AirQualityForecaster,
        :AirQualitySensor,
        :AlertTierAlpha,
        :AlertTierBeta,
        :AlertTierGamma,
        :AnalyticsService,
        :AutonomousAerialVehicle,
