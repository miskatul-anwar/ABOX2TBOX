:ConnectorStandard a owl:Class ;
    rdfs:label "ConnectorStandard" ;
    rdfs:comment "Induced concept for 8 entities characterized by properties: connectorStandard, coolingSystemType, maximumChargeKW, hasChargingInterface." .

