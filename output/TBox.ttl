:FundingGrant a owl:Class ;
    rdfs:label "FundingGrant"^^xsd:string ;
    owl:disjointWith :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
