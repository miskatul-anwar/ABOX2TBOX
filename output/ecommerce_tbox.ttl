[] a owl:Axiom ;
    :aboxSupportCount 24 ;
    :confidenceScore 0.880 ;
    :decisionProbability 0.980 ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource :PhysicalProduct ;
    owl:annotatedTarget :Product ;
    prov:wasAttributedTo "tev1:0.8b"^^xsd:string .

