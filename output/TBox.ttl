:Instructor a owl:Class ;
    rdfs:label "Instructor"^^xsd:string ;
    rdfs:subClassOf :AcademicStaff,
        :Employee ;
    owl:disjointWith :JournalArticle,
        :LabAffiliated,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor ;
    owl:equivalentClass :Lecturer .

:AcademicStaff a owl:Class ;
    rdfs:label "AcademicStaff"^^xsd:string ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :AcademicUnit,
        :AdministrativeStaff,
        :ClericalStaff,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FundingGrant,
        :GraduateCourse,
        :JournalArticle,
        :LabAffiliated,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :Publication,
        :ResearchInstitute,
        :UndergraduateCourse ;
    owl:equivalentClass :Employee .

:FacultyMember a owl:Class ;
    rdfs:label "FacultyMember"^^xsd:string ;
    rdfs:subClassOf :AcademicStaff,
        :Employee ;
    owl:disjointWith :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :TeachingAssistant,
        :UndergraduateCourse .

:JournalArticle a owl:Class ;
    rdfs:label "JournalArticle"^^xsd:string ;
    rdfs:subClassOf :Publication ;
    owl:disjointWith :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :Person,
        :PhDStudent,
        :PostdoctoralResearcher,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:Person a owl:Class ;
    rdfs:label "Person"^^xsd:string ;
    owl:disjointWith :Publication,
        :ResearchInstitute,
        :UndergraduateCourse .

:Lecturer a owl:Class ;
    rdfs:label "Lecturer"^^xsd:string ;
    rdfs:subClassOf :AcademicStaff,
        :Employee ;
    owl:disjointWith :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:Employee a owl:Class ;
    rdfs:label "Employee"^^xsd:string ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Faculty,
        :FundingGrant,
        :GraduateCourse,
        :JournalArticle,
        :LabAffiliated,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :Publication,
        :ResearchInstitute,
        :UndergraduateCourse .

:MasterStudent a owl:Class ;
    rdfs:label "MasterStudent"^^xsd:string ;
    rdfs:subClassOf :GraduateStudent ;
    owl:disjointWith :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:LabAffiliated a owl:Class ;
    rdfs:label "LabAffiliated"^^xsd:string ;
    owl:disjointWith :Lecturer,
