        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:GraduateStudent a owl:Class ;
    rdfs:label "GraduateStudent"^^xsd:string ;
    rdfs:subClassOf :Student ;
    owl:disjointWith :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :Organization,
