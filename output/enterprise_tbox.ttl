        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:FullTimeEmployee a owl:Class ;
    rdfs:label "FullTimeEmployee"^^xsd:string ;
    rdfs:subClassOf :CorporateEmployee,
        :Person ;
    owl:disjointWith :HardwareAsset,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:OfficeFacility a owl:Class ;
    rdfs:label "OfficeFacility"^^xsd:string ;
    rdfs:subClassOf :FacilityAsset ;
