        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:AcademicUnit a owl:Class ;
    rdfs:label "AcademicUnit"^^xsd:string ;
    owl:disjointWith :AdjunctProfessor,
        :AdministrativeStaff,
        :AssistantProfessor,
        :AssociateProfessor,
        :ClericalStaff,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Employee,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
