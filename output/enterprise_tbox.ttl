        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:JuniorFullTimeEmployee a owl:Class ;
    rdfs:label "JuniorFullTimeEmployee"^^xsd:string ;
    rdfs:subClassOf :FullTimeEmployee ;
