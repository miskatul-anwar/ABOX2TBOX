@prefix : <http://example.org/ecommerce#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:EcommerceInducedOntology a owl:Ontology ;
    rdfs:label "Ecommerce Domain Ontology"^^xsd:string .

:accountIdentifier a owl:DatatypeProperty ;
    rdfs:label "accountIdentifier"^^xsd:string .

:appliedPromotion a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "appliedPromotion"^^xsd:string ;
    rdfs:domain :Order ;
    rdfs:range :PromotionCoupon .

:couponCode a owl:DatatypeProperty ;
    rdfs:label "couponCode"^^xsd:string .

:crossPromotedWith a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "crossPromotedWith"^^xsd:string ;
    rdfs:domain :ProductCategory ;
    rdfs:range :ProductCategory .

:customerName a owl:DatatypeProperty ;
    rdfs:label "customerName"^^xsd:string .

:dimensionMeasurement a owl:DatatypeProperty ;
    rdfs:label "dimensionMeasurement"^^xsd:string .

:discountPercentage a owl:DatatypeProperty ;
    rdfs:label "discountPercentage"^^xsd:string .

:downloadUrl a owl:DatatypeProperty ;
    rdfs:label "downloadUrl"^^xsd:string .

:frequentlyBoughtTogether a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "frequentlyBoughtTogether"^^xsd:string ;
    rdfs:domain :PhysicalProduct ;
    rdfs:range :PhysicalProduct .

:hasSpecification a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasSpecification"^^xsd:string ;
    rdfs:domain :ConsumerElectronics ;
    rdfs:range :DimensionMeasurement .

:inStockUnits a owl:DatatypeProperty ;
    rdfs:label "inStockUnits"^^xsd:string .

:includesProduct a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "includesProduct"^^xsd:string ;
    rdfs:domain :Order ;
    rdfs:range :ConsumerElectronics .

:isSubCategoryOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "isSubCategoryOf"^^xsd:string ;
    rdfs:domain :ProductCategory ;
    rdfs:range :ProductCategory .

:orderHasShipment a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "orderHasShipment"^^xsd:string ;
    rdfs:domain :Order ;
    rdfs:range :ShippingCarrier .

:orderTotalAmount a owl:DatatypeProperty ;
    rdfs:label "orderTotalAmount"^^xsd:string .

:placedByCustomer a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "placedByCustomer"^^xsd:string ;
    rdfs:domain :Order ;
    rdfs:range :Customer .

:primaryContactCustomer a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "primaryContactCustomer"^^xsd:string ;
    rdfs:domain :Order ;
    rdfs:range :Customer .

:primaryEmail a owl:DatatypeProperty ;
    rdfs:label "primaryEmail"^^xsd:string .

:productTitle a owl:DatatypeProperty ;
    rdfs:label "productTitle"^^xsd:string .

:promotionTitle a owl:DatatypeProperty ;
    rdfs:label "promotionTitle"^^xsd:string .

:recommendedWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "recommendedWith"^^xsd:string ;
    rdfs:domain :ConsumerElectronics ;
    rdfs:range :ConsumerElectronics .

:reviewRating a owl:DatatypeProperty ;
    rdfs:label "reviewRating"^^xsd:string .

:reviewText a owl:DatatypeProperty ;
    rdfs:label "reviewText"^^xsd:string .

:reviewsProduct a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reviewsProduct"^^xsd:string ;
    rdfs:domain :ProductReview ;
    rdfs:range :ConsumerElectronics .

:shippingCarrier a owl:DatatypeProperty ;
    rdfs:label "shippingCarrier"^^xsd:string .

:shippingStatus a owl:DatatypeProperty ;
    rdfs:label "shippingStatus"^^xsd:string .

:skuCode a owl:DatatypeProperty ;
    rdfs:label "skuCode"^^xsd:string .

:supplierName a owl:DatatypeProperty ;
    rdfs:label "supplierName"^^xsd:string .

:technicalWeight a owl:DatatypeProperty ;
    rdfs:label "technicalWeight"^^xsd:string .

:trackingCode a owl:DatatypeProperty ;
    rdfs:label "trackingCode"^^xsd:string .

:trackingNumber a owl:DatatypeProperty ;
    rdfs:label "trackingNumber"^^xsd:string .

:unitPrice a owl:DatatypeProperty ;
    rdfs:label "unitPrice"^^xsd:string .

:warrantyPeriod a owl:DatatypeProperty ;
    rdfs:label "warrantyPeriod"^^xsd:string .

:AudioAlbum a owl:Class ;
    rdfs:label "AudioAlbum"^^xsd:string ;
    rdfs:subClassOf :DigitalMedia ;
