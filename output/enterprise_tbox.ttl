:CorporateEmployee a owl:Class ;
    rdfs:label "CorporateEmployee"^^xsd:string ;
    owl:disjointWith :DatacenterFacility,
        :EnterpriseAsset,
        :EnterpriseDepartment,
        :ExpenseApproval,
        :FacilityAsset,
        :FiscalBudget,
        :HardwareAsset,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset ;
    owl:equivalentClass :Person .

:FacilityAsset a owl:Class ;
    rdfs:label "FacilityAsset"^^xsd:string ;
    rdfs:subClassOf :EnterpriseAsset ;
    owl:disjointWith :FiscalBudget,
        :FreelanceContractor,
