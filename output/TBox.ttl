        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor ;
    owl:equivalentClass :Organization .

:Course a owl:Class ;
    rdfs:label "Course"^^xsd:string ;
    owl:disjointWith :DegreeConferred,
        :Department,
        :Employee,
        :Faculty,
