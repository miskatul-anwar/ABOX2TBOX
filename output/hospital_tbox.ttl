@prefix : <http://example.org/hospital#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:HospitalInducedOntology a owl:Ontology ;
    rdfs:label "Hospital Domain Ontology"^^xsd:string .

:acuityScore a owl:DatatypeProperty ;
    rdfs:label "acuityScore"^^xsd:string .

:admissionDate a owl:DatatypeProperty ;
    rdfs:label "admissionDate"^^xsd:string .

:appointmentSlot a owl:DatatypeProperty ;
    rdfs:label "appointmentSlot"^^xsd:string .

:assignedAttendingDoctor a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assignedAttendingDoctor"^^xsd:string ;
    rdfs:domain :ClinicalTreatment ;
    rdfs:range :Cardiologist .

:bedNumber a owl:DatatypeProperty ;
    rdfs:label "bedNumber"^^xsd:string .

:bloodPressureSystolic a owl:DatatypeProperty ;
    rdfs:label "bloodPressureSystolic"^^xsd:string .

:consultsWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "consultsWith"^^xsd:string ;
    rdfs:domain :HealthcareStaff ;
    rdfs:range :HealthcareStaff .

:diagnosedByPhysician a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "diagnosedByPhysician"^^xsd:string ;
    rdfs:domain :MedicalDiagnosis ;
    rdfs:range :Cardiologist .

:diagnosisLabel a owl:DatatypeProperty ;
    rdfs:label "diagnosisLabel"^^xsd:string .

:dosageQuantity a owl:DatatypeProperty ;
    rdfs:label "dosageQuantity"^^xsd:string .

:drugGenericName a owl:DatatypeProperty ;
    rdfs:label "drugGenericName"^^xsd:string .

:fdaApprovalNumber a owl:DatatypeProperty ;
    rdfs:label "fdaApprovalNumber"^^xsd:string .

:icd10Code a owl:DatatypeProperty ;
    rdfs:label "icd10Code"^^xsd:string .

:insuranceProviderName a owl:DatatypeProperty ;
    rdfs:label "insuranceProviderName"^^xsd:string .

:intakeFrequency a owl:DatatypeProperty ;
    rdfs:label "intakeFrequency"^^xsd:string .

:labMeasurementValue a owl:DatatypeProperty ;
    rdfs:label "labMeasurementValue"^^xsd:string .

:licenseId a owl:DatatypeProperty ;
    rdfs:label "licenseId"^^xsd:string .

:patientInsurancePolicy a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "patientInsurancePolicy"^^xsd:string ;
    rdfs:domain :ICUPatient ;
    rdfs:range :PolicyInsurance .

:patientLabResult a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "patientLabResult"^^xsd:string ;
    rdfs:domain :ICUPatient ;
    rdfs:range :LabMeasurement .

:patientName a owl:DatatypeProperty ;
    rdfs:label "patientName"^^xsd:string .

:physicianName a owl:DatatypeProperty ;
    rdfs:label "physicianName"^^xsd:string .

:physicianRegistryCode a owl:DatatypeProperty ;
    rdfs:label "physicianRegistryCode"^^xsd:string .

:policyContractNumber a owl:DatatypeProperty ;
    rdfs:label "policyContractNumber"^^xsd:string .

:policyCoverageLimit a owl:DatatypeProperty ;
    rdfs:label "policyCoverageLimit"^^xsd:string .

:prescribedForDiagnosis a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "prescribedForDiagnosis"^^xsd:string ;
    rdfs:domain :ClinicalTreatment ;
    rdfs:range :MedicalDiagnosis .

:referenceRangeNormal a owl:DatatypeProperty ;
    rdfs:label "referenceRangeNormal"^^xsd:string .

:referredPatientTo a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "referredPatientTo"^^xsd:string ;
    rdfs:domain :HealthcareStaff ;
    rdfs:range :HealthcareStaff .

:routeAdministration a owl:DatatypeProperty ;
    rdfs:label "routeAdministration"^^xsd:string .

:severityIndex a owl:DatatypeProperty ;
    rdfs:label "severityIndex"^^xsd:string .

:staffName a owl:DatatypeProperty ;
    rdfs:label "staffName"^^xsd:string .

:subDepartmentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "subDepartmentOf"^^xsd:string ;
    rdfs:domain :HospitalDepartment ;
    rdfs:range :HospitalDepartment .

:testMetricName a owl:DatatypeProperty ;
    rdfs:label "testMetricName"^^xsd:string .

:transferredToWard a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "transferredToWard"^^xsd:string ;
    rdfs:domain :HospitalWard ;
    rdfs:range :HospitalWard .

:treatmentPrescriptionDosage a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "treatmentPrescriptionDosage"^^xsd:string ;
    rdfs:domain :ClinicalTreatment ;
    rdfs:range :DosageQuantity .

:treatmentType a owl:DatatypeProperty ;
    rdfs:label "treatmentType"^^xsd:string .

:triageUrgency a owl:DatatypeProperty ;
    rdfs:label "triageUrgency"^^xsd:string .

:yearsOfExperience a owl:DatatypeProperty ;
    rdfs:label "yearsOfExperience"^^xsd:string .

:ClinicPatient a owl:Class ;
    rdfs:label "ClinicPatient"^^xsd:string ;
    rdfs:subClassOf :Outpatient ;
    owl:disjointWith :ClinicalTreatment,
        :DosageQuantity,
        :EmergencyPatient,
        :GeneralPractitioner,
        :HealthcareStaff,
        :HospitalDepartment,
        :HospitalWard,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Cardiologist a owl:Class ;
    rdfs:label "Cardiologist"^^xsd:string ;
    rdfs:subClassOf :SpecialistPhysician ;
    owl:disjointWith :ClinicPatient,
        :ClinicalTreatment,
        :DosageQuantity,
        :EmergencyPatient,
        :GeneralPractitioner,
        :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:DosageQuantity a owl:Class ;
    rdfs:label "DosageQuantity"^^xsd:string ;
    owl:disjointWith :EmergencyPatient,
        :GeneralPractitioner,
        :HealthcareStaff,
        :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:ClinicalTreatment a owl:Class ;
    rdfs:label "ClinicalTreatment"^^xsd:string ;
    owl:disjointWith :DosageQuantity,
        :EmergencyPatient,
        :GeneralPractitioner,
        :HealthcareStaff,
        :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:EmergencyPatient a owl:Class ;
    rdfs:label "EmergencyPatient"^^xsd:string ;
    rdfs:subClassOf :Outpatient ;
    owl:disjointWith :GeneralPractitioner,
        :HealthcareStaff,
        :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:GeneralPractitioner a owl:Class ;
    rdfs:label "GeneralPractitioner"^^xsd:string ;
    rdfs:subClassOf :Physician ;
    owl:disjointWith :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:HospitalDepartment a owl:Class ;
    rdfs:label "HospitalDepartment"^^xsd:string ;
    owl:disjointWith :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:HospitalWard a owl:Class ;
    rdfs:label "HospitalWard"^^xsd:string ;
    owl:disjointWith :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:ICUPatient a owl:Class ;
    rdfs:label "ICUPatient"^^xsd:string ;
    rdfs:subClassOf :Inpatient ;
    owl:disjointWith :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:LabMeasurement a owl:Class ;
    rdfs:label "LabMeasurement"^^xsd:string ;
    owl:disjointWith :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:LicensedPhysician a owl:Class ;
    rdfs:label "LicensedPhysician"^^xsd:string ;
    owl:disjointWith :MedicalDiagnosis,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC ;
    owl:equivalentClass :MedicalDoctor .

:Person a owl:Class ;
    rdfs:label "Person"^^xsd:string ;
    owl:disjointWith :PolicyInsurance,
        :PrescriptionDrug,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:HealthcareStaff a owl:Class ;
    rdfs:label "HealthcareStaff"^^xsd:string ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :HospitalDepartment,
        :HospitalWard,
        :ICUPatient,
        :Inpatient,
        :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Outpatient,
        :Patient,
        :PolicyInsurance,
        :PrescriptionDrug,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Inpatient a owl:Class ;
    rdfs:label "Inpatient"^^xsd:string ;
    rdfs:subClassOf :Patient ;
    owl:disjointWith :LabMeasurement,
        :LicensedPhysician,
        :MedicalDiagnosis,
        :MedicalDoctor,
        :Neurologist,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:MedicalDoctor a owl:Class ;
    rdfs:label "MedicalDoctor"^^xsd:string ;
    owl:disjointWith :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:MedicalDiagnosis a owl:Class ;
    rdfs:label "MedicalDiagnosis"^^xsd:string ;
    owl:disjointWith :MedicalDoctor,
        :Neurologist,
        :Outpatient,
        :Patient,
        :Person,
        :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Neurologist a owl:Class ;
    rdfs:label "Neurologist"^^xsd:string ;
    rdfs:subClassOf :SpecialistPhysician ;
    owl:disjointWith :Outpatient,
        :Patient,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Outpatient a owl:Class ;
    rdfs:label "Outpatient"^^xsd:string ;
    rdfs:subClassOf :Patient ;
    owl:disjointWith :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Patient a owl:Class ;
    rdfs:label "Patient"^^xsd:string ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Physician,
        :PolicyInsurance,
        :PrescriptionDrug,
        :RegisteredNurse,
        :SpecialistPhysician,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:Physician a owl:Class ;
    rdfs:label "Physician"^^xsd:string ;
    rdfs:subClassOf :HealthcareStaff ;
