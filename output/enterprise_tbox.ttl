@prefix ns1: <http://example.org/enterprise#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:CompanyEmployee a owl:Class ;
    rdfs:label "CompanyEmployee" ;
    owl:disjointWith ns1:FacilityAsset,
        ns1:OfficeFacility .

ns1:DatacenterFacility a owl:Class ;
    rdfs:label "DatacenterFacility" ;
    owl:disjointWith ns1:ExternalConsultant,
        ns1:Person .

ns1:EnterpriseAsset a owl:Class ;
    rdfs:label "EnterpriseAsset" ;
    owl:disjointWith ns1:ProjectMilestoneA .

ns1:Ontology a owl:Ontology ;
    rdfs:label "Core induced ontology (v3.0 Clef-Flash)" ;
    prov:wasAttributedTo "clef-flash:latest" .

ns1:ProjectMilestoneC a owl:Class ;
    rdfs:label "ProjectMilestoneC" .

ns1:ReviewerFeedbackNotes_2 a owl:Class ;
    rdfs:label "ReviewerFeedbackNotes_2" ;
    ns1:competencyQuestion "What specific feedback and rating does a reviewer provide for an employee's performance during a particular evaluation period?" ;
    rdfs:comment "The classes ReviewerFeedback and PerformanceRating describe the notes and scores given by a reviewer, while EvaluationPeriod specifies the timeframe of the performance evaluation." .

ns1:Vendorentity a owl:Class ;
    rdfs:label "Vendorentity" ;
    ns1:competencyQuestion "What is the vendor name, license key identifier, and expiration date period for a given software license entity?" ;
    rdfs:comment "A software license entity is characterized by its vendor name, license key identifier, and expiration date period." .

ns1:allocatedCapitalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "allocatedCapitalAmount" ;
    rdfs:domain ns1:FiscalBudget .

ns1:annualSalary a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "annualSalary" .

ns1:approvalStatusCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "approvalStatusCode" ;
    rdfs:domain ns1:Submittedexpensereport .

ns1:assetDepreciationValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "assetDepreciationValue" ;
    rdfs:domain ns1:ServerAsset .

ns1:assetHostname a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "assetHostname" ;
    rdfs:domain ns1:ComputingDevice .

ns1:contractAgencyName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "contractAgencyName" ;
    rdfs:domain ns1:ExternalConsultant .

ns1:employeeCorporateId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "employeeCorporateId" ;
    rdfs:domain ns1:FullTimeEmployee .

ns1:expenseCategoryCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "expenseCategoryCode" ;
    rdfs:domain ns1:Submittedexpensereport .

ns1:expirationDatePeriod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "expirationDatePeriod" .

ns1:facilityLocationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "facilityLocationCode" ;
    rdfs:domain ns1:FacilityAsset .

ns1:fiscalYearQuarter a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fiscalYearQuarter" ;
    rdfs:domain ns1:FiscalBudget .

ns1:fullName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fullName" ;
    rdfs:domain ns1:CorporateEmployee .

ns1:hourlyBillingRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hourlyBillingRate" ;
    rdfs:domain ns1:ContractWorker .

ns1:licenseKeyIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "licenseKeyIdentifier" .

ns1:officeRoomNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "officeRoomNumber" ;
    rdfs:domain ns1:SeniorFullTimeEmployee .

ns1:payrollId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "payrollId" ;
    rdfs:domain ns1:StaffMember .

ns1:performanceEvaluationPeriod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "performanceEvaluationPeriod" .

ns1:projectName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "projectName" ;
    rdfs:domain ns1:BusinessProject .

ns1:projectStartDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "projectStartDate" ;
    rdfs:domain ns1:BusinessProject .

ns1:reimbursementAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reimbursementAmount" ;
    rdfs:domain ns1:Submittedexpensereport .

ns1:reviewRatingScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reviewRatingScore" .

ns1:reviewerFeedbackNotes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reviewerFeedbackNotes" .

ns1:vendorEntityName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "vendorEntityName" .

ns1:ComputingDevice a owl:Class ;
    rdfs:label "ComputingDevice" ;
    owl:disjointWith ns1:ExternalConsultant,
        ns1:FreelanceContractor,
        ns1:Submittedexpensereport ;
    owl:equivalentClass ns1:HardwareAsset .

ns1:FreelanceContractor a owl:Class ;
    rdfs:label "FreelanceContractor" ;
    owl:disjointWith ns1:SeniorFullTimeEmployee,
        ns1:ServerAsset,
        ns1:StaffMember .

ns1:advises a owl:ObjectProperty ;
    rdfs:label "advises" ;
    rdfs:domain ns1:EnterpriseDepartment ;
    rdfs:range ns1:EnterpriseDepartment .

ns1:assignedSoftwareLicense a owl:ObjectProperty ;
    rdfs:label "assignedSoftwareLicense" ;
    rdfs:domain ns1:ServerAsset ;
    rdfs:range ns1:Licenseassignment .

ns1:FacilityAsset a owl:Class ;
    rdfs:label "FacilityAsset" ;
    owl:disjointWith ns1:Person .

ns1:FiscalBudget a owl:Class ;
    rdfs:label "FiscalBudget" ;
    owl:disjointWith ns1:OfficeFacility,
        ns1:ProjectMilestoneB .

ns1:HardwareAsset a owl:Class ;
    rdfs:label "HardwareAsset" ;
    owl:disjointWith ns1:OfficeFacility,
        ns1:Person,
        ns1:ProjectMilestoneA,
        ns1:ProjectMilestoneB,
        ns1:SeniorFullTimeEmployee,
        ns1:StaffMember,
        ns1:Submittedexpensereport .

ns1:ProjectMilestoneB a owl:Class ;
    rdfs:label "ProjectMilestoneB" .

ns1:WorkstationAsset a owl:Class ;
    rdfs:label "WorkstationAsset" .

ns1:mentors a owl:ObjectProperty ;
    rdfs:label "mentors" ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Person .

ns1:subDivisionOf a owl:ObjectProperty ;
    rdfs:label "subDivisionOf" ;
    rdfs:domain ns1:EnterpriseDepartment ;
    rdfs:range ns1:EnterpriseDepartment .

ns1:BusinessProject a owl:Class ;
    rdfs:label "BusinessProject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject linked via assignedProjectLead has only fillers of type ExecutiveDirector" ;
            owl:allValuesFrom ns1:ExecutiveDirector ;
            owl:onProperty ns1:assignedProjectLead ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject is linked via assignedProjectLead to at least one instance of CorporateEmployee" ;
            owl:onProperty ns1:assignedProjectLead ;
            owl:someValuesFrom ns1:CorporateEmployee ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject is linked via assignedProjectLead to at least one instance of ExecutiveDirector" ;
            owl:onProperty ns1:assignedProjectLead ;
            owl:someValuesFrom ns1:ExecutiveDirector ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject is linked via assignedProjectLead to at least one instance of FullTimeEmployee" ;
            owl:onProperty ns1:assignedProjectLead ;
            owl:someValuesFrom ns1:FullTimeEmployee ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject linked via assignedProjectLead has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:assignedProjectLead ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject linked via assignedProjectLead has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:assignedProjectLead ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject linked via assignedProjectLead has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:assignedProjectLead ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.47e-01 ;
            rdfs:comment "Every instance of BusinessProject is linked via assignedProjectLead to at least one instance of Person" ;
            owl:onProperty ns1:assignedProjectLead ;
            owl:someValuesFrom ns1:Person ] .

ns1:ContractWorker a owl:Class ;
    rdfs:label "ContractWorker" ;
    rdfs:subClassOf ns1:Person ;
    owl:disjointWith ns1:FullTimeEmployee,
        ns1:JuniorFullTimeEmployee .

ns1:ExternalConsultant a owl:Class ;
    rdfs:label "ExternalConsultant" ;
    owl:disjointWith ns1:HardwareAsset,
        ns1:Licenseassignment,
        ns1:SeniorFullTimeEmployee .

ns1:Licenseassignment a owl:Class ;
    rdfs:label "Licenseassignment" ;
    ns1:competencyQuestion "What is the relationship between a vendor entity and the software licenses it assigns, including the key identifier, expiration date, and the name of the vendor, and how are these licenses managed over time?" ;
    rdfs:comment "VendorEntity manages SoftwareLicense assignments, each with a unique LicenseKeyIdentifier and expiration date, through the process of LicenseAssignment." .

ns1:OfficeFacility a owl:Class ;
    rdfs:label "OfficeFacility" ;
    owl:disjointWith ns1:Person,
        ns1:ProjectMilestoneA .

ns1:ProjectMilestoneA a owl:Class ;
    rdfs:label "ProjectMilestoneA" .

ns1:ServerAsset a owl:Class ;
    rdfs:label "ServerAsset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 9.01e-01 ;
            rdfs:comment "Every instance of ServerAsset is linked via assignedSoftwareLicense to at least one instance of Licenseassignment" ;
            owl:onProperty ns1:assignedSoftwareLicense ;
            owl:someValuesFrom ns1:Licenseassignment ] .

ns1:JuniorFullTimeEmployee a owl:Class ;
    rdfs:label "JuniorFullTimeEmployee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of JuniorFullTimeEmployee linked via employeePerformanceReview has only fillers of type ReviewerFeedbackNotes" ;
            owl:allValuesFrom ns1:ReviewerFeedbackNotes ;
            owl:onProperty ns1:employeePerformanceReview ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.3e-01 ;
            rdfs:comment "Every instance of JuniorFullTimeEmployee is linked via submittedExpenseReport to at least one instance of Submittedexpensereport" ;
            owl:onProperty ns1:submittedExpenseReport ;
            owl:someValuesFrom ns1:Submittedexpensereport ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.3e-01 ;
            rdfs:comment "Every instance of JuniorFullTimeEmployee linked via submittedExpenseReport has only fillers of type Submittedexpensereport" ;
            owl:allValuesFrom ns1:Submittedexpensereport ;
            owl:onProperty ns1:submittedExpenseReport ],
        [ a owl:Restriction ;
            ns1:celoeScore 8.39e-01 ;
            rdfs:comment "Every instance of JuniorFullTimeEmployee is linked via employeePerformanceReview to at least one instance of ReviewerFeedbackNotes" ;
            owl:onProperty ns1:employeePerformanceReview ;
            owl:someValuesFrom ns1:ReviewerFeedbackNotes ],
        ns1:Person .

ns1:StaffMember a owl:Class ;
    rdfs:label "StaffMember" .

ns1:ExecutiveDirector a owl:Class ;
    rdfs:label "ExecutiveDirector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ExecutiveDirector linked via collaboratesWith has only fillers of type SeniorFullTimeEmployee" ;
            owl:allValuesFrom ns1:SeniorFullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ExecutiveDirector linked via collaboratesWith has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ExecutiveDirector linked via collaboratesWith has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ExecutiveDirector linked via collaboratesWith has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        ns1:Person ;
    owl:disjointWith ns1:JuniorFullTimeEmployee .

ns1:employeePerformanceReview a owl:ObjectProperty ;
    rdfs:label "employeePerformanceReview" ;
    rdfs:domain ns1:CorporateEmployee ;
    rdfs:range ns1:ReviewerFeedbackNotes .

ns1:submittedExpenseReport a owl:ObjectProperty ;
    rdfs:label "submittedExpenseReport" ;
    rdfs:range ns1:Submittedexpensereport .

ns1:ReviewerFeedbackNotes a owl:Class ;
    rdfs:label "ReviewerFeedbackNotes" ;
    ns1:competencyQuestion "What specific feedback and rating does the reviewer provide for an employee's performance during a particular evaluation period?" ;
    rdfs:comment "PerformanceEvaluation captures the structured representation of an employee's performance review, including feedback, rating, and the evaluation period." .

ns1:EnterpriseDepartment a owl:Class ;
    rdfs:label "EnterpriseDepartment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7.7e-01 ;
            rdfs:comment "Every instance of EnterpriseDepartment is linked via advises to at least one instance of EnterpriseDepartment" ;
            owl:onProperty ns1:advises ;
            owl:someValuesFrom ns1:EnterpriseDepartment ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.7e-01 ;
            rdfs:comment "Every instance of EnterpriseDepartment is linked via subDivisionOf to at least one instance of EnterpriseDepartment" ;
            owl:onProperty ns1:subDivisionOf ;
            owl:someValuesFrom ns1:EnterpriseDepartment ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.7e-01 ;
            rdfs:comment "Every instance of EnterpriseDepartment linked via subDivisionOf has only fillers of type EnterpriseDepartment" ;
            owl:allValuesFrom ns1:EnterpriseDepartment ;
            owl:onProperty ns1:subDivisionOf ] ;
    owl:disjointWith ns1:StaffMember,
        ns1:Submittedexpensereport,
        ns1:WorkstationAsset .

ns1:assignedProjectLead a owl:ObjectProperty ;
    rdfs:label "assignedProjectLead" ;
    rdfs:domain ns1:BusinessProject ;
    rdfs:range ns1:ExecutiveDirector .

ns1:CorporateEmployee a owl:Class ;
    rdfs:label "CorporateEmployee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via collaboratesWith has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via collaboratesWith has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via collaboratesWith has only fillers of type SeniorFullTimeEmployee" ;
            owl:allValuesFrom ns1:SeniorFullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via collaboratesWith has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via employeePerformanceReview has only fillers of type ReviewerFeedbackNotes" ;
            owl:allValuesFrom ns1:ReviewerFeedbackNotes ;
            owl:onProperty ns1:employeePerformanceReview ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via mentors has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:mentors ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of CorporateEmployee linked via submittedExpenseReport has only fillers of type Submittedexpensereport" ;
            owl:allValuesFrom ns1:Submittedexpensereport ;
            owl:onProperty ns1:submittedExpenseReport ],
        ns1:Person .

ns1:FullTimeEmployee a owl:Class ;
    rdfs:label "FullTimeEmployee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via collaboratesWith has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via submittedExpenseReport has only fillers of type Submittedexpensereport" ;
            owl:allValuesFrom ns1:Submittedexpensereport ;
            owl:onProperty ns1:submittedExpenseReport ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via collaboratesWith has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via collaboratesWith has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via collaboratesWith has only fillers of type SeniorFullTimeEmployee" ;
            owl:allValuesFrom ns1:SeniorFullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of FullTimeEmployee linked via employeePerformanceReview has only fillers of type ReviewerFeedbackNotes" ;
            owl:allValuesFrom ns1:ReviewerFeedbackNotes ;
            owl:onProperty ns1:employeePerformanceReview ],
        ns1:Person .

ns1:SeniorFullTimeEmployee a owl:Class ;
    rdfs:label "SeniorFullTimeEmployee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SeniorFullTimeEmployee linked via collaboratesWith has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SeniorFullTimeEmployee linked via collaboratesWith has only fillers of type SeniorFullTimeEmployee" ;
            owl:allValuesFrom ns1:SeniorFullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SeniorFullTimeEmployee linked via collaboratesWith has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SeniorFullTimeEmployee linked via collaboratesWith has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ] .

ns1:Submittedexpensereport a owl:Class ;
    rdfs:label "Submittedexpensereport" ;
    ns1:competencyQuestion "What is the reimbursement amount and status code for a given submitted expense report, and what category does the expense fall under?" ;
    rdfs:comment "SubmittedExpenseReport is a class that captures the details of an expense report, including its reimbursement amount, status code, and category." ;
    owl:disjointWith ns1:WorkstationAsset .

ns1:collaboratesWith a owl:ObjectProperty ;
    rdfs:label "collaboratesWith" ;
    rdfs:domain ns1:SeniorFullTimeEmployee ;
    rdfs:range ns1:SeniorFullTimeEmployee .

ns1:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via collaboratesWith has only fillers of type SeniorFullTimeEmployee" ;
            owl:allValuesFrom ns1:SeniorFullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via collaboratesWith has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via mentors has only fillers of type Person" ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:mentors ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via employeePerformanceReview has only fillers of type ReviewerFeedbackNotes" ;
            owl:allValuesFrom ns1:ReviewerFeedbackNotes ;
            owl:onProperty ns1:employeePerformanceReview ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via collaboratesWith has only fillers of type FullTimeEmployee" ;
            owl:allValuesFrom ns1:FullTimeEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via collaboratesWith has only fillers of type CorporateEmployee" ;
            owl:allValuesFrom ns1:CorporateEmployee ;
            owl:onProperty ns1:collaboratesWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Person linked via submittedExpenseReport has only fillers of type Submittedexpensereport" ;
            owl:allValuesFrom ns1:Submittedexpensereport ;
            owl:onProperty ns1:submittedExpenseReport ] .

[] a rdf:Statement,
        owl:Axiom ;
    ns1:aboxSupportCount 16 ;
    ns1:confidenceScore 8.91e-01 ;
    ns1:decisionProbability 9.7e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 1.971e+00 ;
    rdf:object ns1:Person ;
    rdf:predicate rdfs:subClassOf ;
    rdf:subject ns1:FullTimeEmployee ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ns1:FullTimeEmployee ;
    owl:annotatedTarget ns1:Person ;
    prov:wasAttributedTo "clef-flash:latest" .

