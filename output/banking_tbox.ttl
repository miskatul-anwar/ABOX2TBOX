        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:ContactlessDebitCard a owl:Class ;
    rdfs:label "ContactlessDebitCard"^^xsd:string ;
    rdfs:subClassOf :BankPaymentCard ;
    owl:disjointWith :CreditAccount,
        :CreditCard,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity ;
    owl:equivalentClass :DebitCard .

:DebitCard a owl:Class ;
    rdfs:label "DebitCard"^^xsd:string ;
    rdfs:subClassOf :BankPaymentCard ;
    owl:disjointWith :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:BankPaymentCard a owl:Class ;
    rdfs:label "BankPaymentCard"^^xsd:string ;
    rdfs:subClassOf :PaymentInstrument ;
    owl:disjointWith :CheckingAccount,
        :CollateralAppraised,
        :CreditAccount,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:CreditAccount a owl:Class ;
    rdfs:label "CreditAccount"^^xsd:string ;
    rdfs:subClassOf :FinancialAccount ;
    owl:disjointWith :CreditCard,
        :DebitCard,
        :FeeSchedule,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity ;
    owl:equivalentClass :LoanAccount .

:CheckingAccount a owl:Class ;
    rdfs:label "CheckingAccount"^^xsd:string ;
    rdfs:subClassOf :DepositoryAccount ;
    owl:disjointWith :CollateralAppraised,
        :ContactlessDebitCard,
        :CreditCard,
        :DebitCard,
        :FeeSchedule,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :TokenSecurity .

:CreditCard a owl:Class ;
    rdfs:label "CreditCard"^^xsd:string ;
    rdfs:subClassOf :BankPaymentCard ;
    owl:disjointWith :DebitCard,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:FeeSchedule a owl:Class ;
    rdfs:label "FeeSchedule"^^xsd:string ;
    owl:disjointWith :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:FinancialAccount a owl:Class ;
    rdfs:label "FinancialAccount"^^xsd:string ;
    owl:disjointWith :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :TokenSecurity .

:GoldCreditCard a owl:Class ;
    rdfs:label "GoldCreditCard"^^xsd:string ;
    rdfs:subClassOf :CreditCard ;
    owl:disjointWith :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:DepositoryAccount a owl:Class ;
    rdfs:label "DepositoryAccount"^^xsd:string ;
    rdfs:subClassOf :FinancialAccount ;
    owl:disjointWith :FeeSchedule,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :TokenSecurity .

:FinancialTransaction a owl:Class ;
    rdfs:label "FinancialTransaction"^^xsd:string ;
    owl:disjointWith :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:HighYieldSavingsAccount a owl:Class ;
    rdfs:label "HighYieldSavingsAccount"^^xsd:string ;
    rdfs:subClassOf :DepositoryAccount ;
    owl:disjointWith :LoanAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :StudentCheckingAccount,
        :TokenSecurity ;
    owl:equivalentClass :SavingsAccount .

:MortgageLoanAccount a owl:Class ;
    rdfs:label "MortgageLoanAccount"^^xsd:string ;
    rdfs:subClassOf :CreditAccount,
        :LoanAccount ;
    owl:disjointWith :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:PaymentInstrument a owl:Class ;
    rdfs:label "PaymentInstrument"^^xsd:string ;
    owl:disjointWith :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:PremiumCheckingAccount a owl:Class ;
    rdfs:label "PremiumCheckingAccount"^^xsd:string ;
    rdfs:subClassOf :CheckingAccount ;
    owl:disjointWith :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:LoanAccount a owl:Class ;
    rdfs:label "LoanAccount"^^xsd:string ;
    rdfs:subClassOf :FinancialAccount ;
    owl:disjointWith :PaymentInstrument,
        :PlatinumCreditCard,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:PlatinumCreditCard a owl:Class ;
    rdfs:label "PlatinumCreditCard"^^xsd:string ;
    rdfs:subClassOf :CreditCard ;
    owl:disjointWith :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:FinancialCustomer a owl:Class ;
    rdfs:label "FinancialCustomer"^^xsd:string ;
    owl:disjointWith :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:RiskRatingTierA a owl:Class ;
    rdfs:label "RiskRatingTierA"^^xsd:string ;
    owl:disjointWith :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:RiskRatingTierB a owl:Class ;
    rdfs:label "RiskRatingTierB"^^xsd:string ;
    owl:disjointWith :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:RiskRatingTierC a owl:Class ;
    rdfs:label "RiskRatingTierC"^^xsd:string ;
    owl:disjointWith :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:SavingsAccount a owl:Class ;
    rdfs:label "SavingsAccount"^^xsd:string ;
    rdfs:subClassOf :DepositoryAccount ;
    owl:disjointWith :StudentCheckingAccount,
        :TokenSecurity .

:StudentCheckingAccount a owl:Class ;
    rdfs:label "StudentCheckingAccount"^^xsd:string ;
    rdfs:subClassOf :CheckingAccount ;
    owl:disjointWith :TokenSecurity .

:TokenSecurity a owl:Class ;
    rdfs:label "TokenSecurity"^^xsd:string .

