:SeniorFullTimeEmployee a owl:Class ;
    rdfs:label "SeniorFullTimeEmployee"^^xsd:string ;
    rdfs:subClassOf :FullTimeEmployee ;
    owl:disjointWith :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:ServerAsset a owl:Class ;
    rdfs:label "ServerAsset"^^xsd:string ;
    rdfs:subClassOf :ComputingDevice,
        :HardwareAsset ;
    owl:disjointWith :StaffMember,
        :WorkstationAsset .

:StaffMember a owl:Class ;
    rdfs:label "StaffMember"^^xsd:string ;
    owl:disjointWith :WorkstationAsset .

:WorkstationAsset a owl:Class ;
    rdfs:label "WorkstationAsset"^^xsd:string ;
    rdfs:subClassOf :ComputingDevice,
        :HardwareAsset .

