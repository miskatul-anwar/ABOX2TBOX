@prefix : <http://example.org/enterprise#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:EnterpriseInducedOntology a owl:Ontology ;
    rdfs:label "Enterprise Domain Ontology"^^xsd:string .

:advises a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "advises"^^xsd:string ;
    rdfs:domain :EnterpriseDepartment ;
    rdfs:range :EnterpriseDepartment .

:allocatedCapitalAmount a owl:DatatypeProperty ;
    rdfs:label "allocatedCapitalAmount"^^xsd:string .

:annualSalary a owl:DatatypeProperty ;
    rdfs:label "annualSalary"^^xsd:string .

:approvalStatusCode a owl:DatatypeProperty ;
    rdfs:label "approvalStatusCode"^^xsd:string .

:assetDepreciationValue a owl:DatatypeProperty ;
    rdfs:label "assetDepreciationValue"^^xsd:string .

:assetHostname a owl:DatatypeProperty ;
    rdfs:label "assetHostname"^^xsd:string .

:assignedProjectLead a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assignedProjectLead"^^xsd:string ;
    rdfs:domain :BusinessProject ;
    rdfs:range :CorporateEmployee .

:assignedSoftwareLicense a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assignedSoftwareLicense"^^xsd:string ;
    rdfs:domain :ComputingDevice ;
    rdfs:range :LicenseExpiration .

:collaboratesWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaboratesWith"^^xsd:string ;
    rdfs:domain :CorporateEmployee ;
    rdfs:range :CorporateEmployee .

:contractAgencyName a owl:DatatypeProperty ;
    rdfs:label "contractAgencyName"^^xsd:string .

:employeeCorporateId a owl:DatatypeProperty ;
    rdfs:label "employeeCorporateId"^^xsd:string .

:employeePerformanceReview a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "employeePerformanceReview"^^xsd:string ;
    rdfs:domain :CorporateEmployee ;
    rdfs:range :PerformanceReview .

:expenseCategoryCode a owl:DatatypeProperty ;
    rdfs:label "expenseCategoryCode"^^xsd:string .

:expirationDatePeriod a owl:DatatypeProperty ;
    rdfs:label "expirationDatePeriod"^^xsd:string .

:facilityLocationCode a owl:DatatypeProperty ;
    rdfs:label "facilityLocationCode"^^xsd:string .

:fiscalYearQuarter a owl:DatatypeProperty ;
    rdfs:label "fiscalYearQuarter"^^xsd:string .

:fullName a owl:DatatypeProperty ;
    rdfs:label "fullName"^^xsd:string .

:hourlyBillingRate a owl:DatatypeProperty ;
    rdfs:label "hourlyBillingRate"^^xsd:string .

:licenseKeyIdentifier a owl:DatatypeProperty ;
    rdfs:label "licenseKeyIdentifier"^^xsd:string .

:mentors a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "mentors"^^xsd:string ;
    rdfs:domain :CorporateEmployee ;
    rdfs:range :CorporateEmployee .

:officeRoomNumber a owl:DatatypeProperty ;
    rdfs:label "officeRoomNumber"^^xsd:string .

:payrollId a owl:DatatypeProperty ;
    rdfs:label "payrollId"^^xsd:string .

:performanceEvaluationPeriod a owl:DatatypeProperty ;
    rdfs:label "performanceEvaluationPeriod"^^xsd:string .

:projectName a owl:DatatypeProperty ;
    rdfs:label "projectName"^^xsd:string .

:projectStartDate a owl:DatatypeProperty ;
    rdfs:label "projectStartDate"^^xsd:string .

:reimbursementAmount a owl:DatatypeProperty ;
    rdfs:label "reimbursementAmount"^^xsd:string .

:reviewRatingScore a owl:DatatypeProperty ;
    rdfs:label "reviewRatingScore"^^xsd:string .

:reviewerFeedbackNotes a owl:DatatypeProperty ;
    rdfs:label "reviewerFeedbackNotes"^^xsd:string .

:subDivisionOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "subDivisionOf"^^xsd:string ;
    rdfs:domain :EnterpriseDepartment ;
    rdfs:range :EnterpriseDepartment .

:submittedExpenseReport a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "submittedExpenseReport"^^xsd:string ;
    rdfs:domain :CorporateEmployee ;
    rdfs:range :ExpenseApproval .

:vendorEntityName a owl:DatatypeProperty ;
    rdfs:label "vendorEntityName"^^xsd:string .

:BusinessProject a owl:Class ;
    rdfs:label "BusinessProject"^^xsd:string ;
    owl:disjointWith :CompanyEmployee,
        :ComputingDevice,
        :ContractWorker,
        :CorporateEmployee,
        :DatacenterFacility,
        :EnterpriseAsset,
        :EnterpriseDepartment,
        :ExecutiveDirector,
        :ExpenseApproval,
        :ExternalConsultant,
        :FacilityAsset,
        :FiscalBudget,
        :FreelanceContractor,
        :FullTimeEmployee,
        :HardwareAsset,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :Person,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :SeniorFullTimeEmployee,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:CompanyEmployee a owl:Class ;
    rdfs:label "CompanyEmployee"^^xsd:string ;
    owl:disjointWith :ComputingDevice,
        :ContractWorker,
        :CorporateEmployee,
        :DatacenterFacility,
        :EnterpriseAsset,
        :EnterpriseDepartment,
        :ExecutiveDirector,
        :ExpenseApproval,
        :ExternalConsultant,
        :FacilityAsset,
        :FiscalBudget,
        :FreelanceContractor,
        :FullTimeEmployee,
        :HardwareAsset,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :Person,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :SeniorFullTimeEmployee,
        :ServerAsset,
        :WorkstationAsset ;
    owl:equivalentClass :StaffMember .

:DatacenterFacility a owl:Class ;
    rdfs:label "DatacenterFacility"^^xsd:string ;
    rdfs:subClassOf :FacilityAsset ;
    owl:disjointWith :EnterpriseDepartment,
        :ExecutiveDirector,
        :ExpenseApproval,
        :ExternalConsultant,
        :FiscalBudget,
        :FreelanceContractor,
        :FullTimeEmployee,
        :HardwareAsset,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :Person,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :SeniorFullTimeEmployee,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:ExecutiveDirector a owl:Class ;
    rdfs:label "ExecutiveDirector"^^xsd:string ;
    rdfs:subClassOf :SeniorFullTimeEmployee ;
    owl:disjointWith :ExpenseApproval,
        :FacilityAsset,
        :FiscalBudget,
        :FreelanceContractor,
        :HardwareAsset,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:ComputingDevice a owl:Class ;
    rdfs:label "ComputingDevice"^^xsd:string ;
    rdfs:subClassOf :EnterpriseAsset ;
    owl:disjointWith :ContractWorker,
        :CorporateEmployee,
        :DatacenterFacility,
        :EnterpriseDepartment,
        :ExecutiveDirector,
        :ExpenseApproval,
        :ExternalConsultant,
        :FacilityAsset,
        :FiscalBudget,
        :FreelanceContractor,
        :FullTimeEmployee,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :Person,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :SeniorFullTimeEmployee,
        :StaffMember ;
    owl:equivalentClass :HardwareAsset .

:ExternalConsultant a owl:Class ;
    rdfs:label "ExternalConsultant"^^xsd:string ;
    rdfs:subClassOf :ContractWorker ;
    owl:disjointWith :FacilityAsset,
        :FiscalBudget,
        :FreelanceContractor,
        :HardwareAsset,
        :JuniorFullTimeEmployee,
        :LicenseExpiration,
        :OfficeFacility,
        :PerformanceReview,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:ContractWorker a owl:Class ;
    rdfs:label "ContractWorker"^^xsd:string ;
    rdfs:subClassOf :CorporateEmployee,
        :Person ;
