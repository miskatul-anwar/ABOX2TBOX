qb:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            qb:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Observation linked via Habitat has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Habitat> ],
        [ a owl:Restriction ;
            qb:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Observation linked via Sector has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Sector> ],
        [ a owl:Restriction ;
            qb:celoeScore 9.12e-01 ;
            rdfs:comment "Every instance of Observation is linked via Time to at least one instance of LevelMember" ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Time> ;
            owl:someValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ],
        [ a owl:Restriction ;
            qb:celoeScore 9.12e-01 ;
            rdfs:comment "Every instance of Observation linked via Time has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Time> ],
        [ a owl:Restriction ;
            qb:celoeScore 7e-01 ;
            rdfs:comment "Every instance of Observation linked via Sector has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://bike-csecu.com/datasets/agri/abox/mdAttribute#LevelMember> ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Sector> ],
        [ a owl:Restriction ;
            qb:celoeScore 9.04e-01 ;
            rdfs:comment "Every instance of Observation linked via District has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#District> ],
        [ a owl:Restriction ;
            qb:celoeScore 9.04e-01 ;
            rdfs:comment "Every instance of Observation is linked via District to at least one instance of LevelMember" ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#District> ;
            owl:someValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ],
        [ a owl:Restriction ;
            qb:celoeScore 7.92e-01 ;
            rdfs:comment "Every instance of Observation is linked via Product to at least one instance of LevelMember" ;
            owl:onProperty <http://bike-csecu.com/datasets/agri/abox/mdProperty#Product> ;
            owl:someValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ] .

<http://bike-csecu.com/datasets/agri/abox/mdAttribute#LevelMember> a owl:Class ;
    rdfs:label "LevelMember" ;
    rdfs:subClassOf [ a owl:Restriction ;
            qb:celoeScore 1.01e+00 ;
            rdfs:comment "Every instance of LevelMember is linked via inAgriculture to at least one instance of LevelMember" ;
            owl:onProperty <http://purl.org/qb4olap/cubes#inAgriculture> ;
            owl:someValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ],
        [ a owl:Restriction ;
            qb:celoeScore 1.01e+00 ;
            rdfs:comment "Every instance of LevelMember linked via inAgriculture has only fillers of type LevelMember" ;
            owl:allValuesFrom <http://purl.org/qb4olap/cubes#LevelMember> ;
            owl:onProperty <http://purl.org/qb4olap/cubes#inAgriculture> ] .

<http://purl.org/qb4olap/cubes#LevelMember> a owl:Class ;
    rdfs:label "LevelMember" ;
    rdfs:subClassOf [ a owl:Restriction ;
            qb:celoeScore 7e-01 ;
