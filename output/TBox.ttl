        :UndergraduateCourse,
        :VisitingProfessor .

:Organization a owl:Class ;
    rdfs:label "Organization"^^xsd:string ;
    owl:disjointWith :Person,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:UndergraduateStudent a owl:Class ;
    rdfs:label "UndergraduateStudent"^^xsd:string ;
    rdfs:subClassOf :Student ;
    owl:disjointWith :VisitingProfessor .

:ResearchInstitute a owl:Class ;
    rdfs:label "ResearchInstitute"^^xsd:string ;
    rdfs:subClassOf :AcademicUnit,
        :Organization ;
    owl:disjointWith :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:TeachingAssistant a owl:Class ;
    rdfs:label "TeachingAssistant"^^xsd:string ;
    rdfs:subClassOf :AcademicStaff,
        :Employee,
        :GraduateStudent ;
    owl:disjointWith :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:TenureTrackFaculty a owl:Class ;
    rdfs:label "TenureTrackFaculty"^^xsd:string ;
    rdfs:subClassOf :FacultyMember ;
    owl:disjointWith :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:TenuredFaculty a owl:Class ;
    rdfs:label "TenuredFaculty"^^xsd:string ;
    rdfs:subClassOf :FacultyMember ;
    owl:disjointWith :UndergraduateCourse,
        :VisitingProfessor .

:VisitingProfessor a owl:Class ;
    rdfs:label "VisitingProfessor"^^xsd:string ;
    rdfs:subClassOf :FacultyMember .

:Publication a owl:Class ;
    rdfs:label "Publication"^^xsd:string ;
    owl:disjointWith :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:UndergraduateCourse a owl:Class ;
    rdfs:label "UndergraduateCourse"^^xsd:string ;
    rdfs:subClassOf :Course ;
    owl:disjointWith :UndergraduateStudent,
        :VisitingProfessor .

[] a owl:Axiom ;
    :aboxSupportCount 10 ;
    :confidenceScore 0.880 ;
    :decisionProbability 0.980 ;
    owl:annotatedProperty rdfs:subClassOf ;
