@prefix : <http://example.org/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AccountHolder a owl:Class ;
    rdfs:label "AccountHolder"^^xsd:string ;
    owl:disjointWith :AutoLoanAccount,
        :BankBranch,
        :BankPaymentCard,
        :CheckingAccount,
        :CollateralAppraised,
        :ContactlessDebitCard,
        :CreditAccount,
        :CreditCard,
        :DebitCard,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :LoanAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity ;
    owl:equivalentClass :BankClient .

:BankingInducedOntology a owl:Ontology ;
    rdfs:label "Banking Domain Ontology"^^xsd:string .

:accountBalanceCurrent a owl:DatatypeProperty ;
    rdfs:label "accountBalanceCurrent"^^xsd:string .

:accountPrimaryOwner a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "accountPrimaryOwner"^^xsd:string ;
    rdfs:domain :CheckingAccount ;
    rdfs:range :FinancialCustomer .

:appraisedCollateralValue a owl:DatatypeProperty ;
    rdfs:label "appraisedCollateralValue"^^xsd:string .

:cardCreditLimit a owl:DatatypeProperty ;
    rdfs:label "cardCreditLimit"^^xsd:string .

:cardMaskedPan a owl:DatatypeProperty ;
    rdfs:label "cardMaskedPan"^^xsd:string .

:clientTaxIdentifier a owl:DatatypeProperty ;
    rdfs:label "clientTaxIdentifier"^^xsd:string .

:coSignerWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "coSignerWith"^^xsd:string ;
    rdfs:domain :FinancialCustomer ;
    rdfs:range :FinancialCustomer .

:collateralAssetType a owl:DatatypeProperty ;
    rdfs:label "collateralAssetType"^^xsd:string .

:creditScoreFico a owl:DatatypeProperty ;
    rdfs:label "creditScoreFico"^^xsd:string .

:customerLegalName a owl:DatatypeProperty ;
    rdfs:label "customerLegalName"^^xsd:string .

:customerSecurityToken a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "customerSecurityToken"^^xsd:string ;
    rdfs:domain :FinancialCustomer ;
    rdfs:range :TokenSecurity .

:dailyAtmWithdrawalLimit a owl:DatatypeProperty ;
    rdfs:label "dailyAtmWithdrawalLimit"^^xsd:string .

:feeScheduleVersion a owl:DatatypeProperty ;
    rdfs:label "feeScheduleVersion"^^xsd:string .

:governedByFeeSchedule a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "governedByFeeSchedule"^^xsd:string ;
    rdfs:domain :CheckingAccount ;
    rdfs:range :FeeSchedule .

:ibanIdentifierCode a owl:DatatypeProperty ;
    rdfs:label "ibanIdentifierCode"^^xsd:string .

:instrumentDescription a owl:DatatypeProperty ;
    rdfs:label "instrumentDescription"^^xsd:string .

:interestRateYield a owl:DatatypeProperty ;
    rdfs:label "interestRateYield"^^xsd:string .

:jointAccountWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "jointAccountWith"^^xsd:string ;
    rdfs:domain :FinancialCustomer ;
    rdfs:range :FinancialCustomer .

:loanInterestRate a owl:DatatypeProperty ;
    rdfs:label "loanInterestRate"^^xsd:string .

:loanMaturityTermMonths a owl:DatatypeProperty ;
    rdfs:label "loanMaturityTermMonths"^^xsd:string .

:monthlyMaintenanceFee a owl:DatatypeProperty ;
    rdfs:label "monthlyMaintenanceFee"^^xsd:string .

:originatingAccount a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "originatingAccount"^^xsd:string ;
    rdfs:domain :FinancialTransaction ;
    rdfs:range :CheckingAccount .

:overdraftLimitAmount a owl:DatatypeProperty ;
    rdfs:label "overdraftLimitAmount"^^xsd:string .

:parentBranchOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "parentBranchOf"^^xsd:string ;
    rdfs:domain :BankBranch ;
    rdfs:range :BankBranch .

:penaltyChargeRate a owl:DatatypeProperty ;
    rdfs:label "penaltyChargeRate"^^xsd:string .

:pledgeDocumentId a owl:DatatypeProperty ;
    rdfs:label "pledgeDocumentId"^^xsd:string .

:principalLoanAmount a owl:DatatypeProperty ;
    rdfs:label "principalLoanAmount"^^xsd:string .

:securedByCollateral a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "securedByCollateral"^^xsd:string ;
    rdfs:domain :CreditAccount ;
    rdfs:range :CollateralAppraised .

:securityAlgorithmType a owl:DatatypeProperty ;
    rdfs:label "securityAlgorithmType"^^xsd:string .

:settlementTimestamp a owl:DatatypeProperty ;
    rdfs:label "settlementTimestamp"^^xsd:string .

:tokenExpirationTimestamp a owl:DatatypeProperty ;
    rdfs:label "tokenExpirationTimestamp"^^xsd:string .

:tokenSerialNumber a owl:DatatypeProperty ;
    rdfs:label "tokenSerialNumber"^^xsd:string .

:transactionAmountValue a owl:DatatypeProperty ;
    rdfs:label "transactionAmountValue"^^xsd:string .

:wireTransferredTo a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "wireTransferredTo"^^xsd:string ;
    rdfs:domain :BankBranch ;
    rdfs:range :BankBranch .

:AutoLoanAccount a owl:Class ;
    rdfs:label "AutoLoanAccount"^^xsd:string ;
    rdfs:subClassOf :CreditAccount,
        :LoanAccount ;
    owl:disjointWith :BankBranch,
        :BankClient,
        :BankPaymentCard,
        :CheckingAccount,
        :CollateralAppraised,
        :ContactlessDebitCard,
        :CreditCard,
        :DebitCard,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialCustomer,
        :FinancialTransaction,
        :GoldCreditCard,
        :HighYieldSavingsAccount,
        :MortgageLoanAccount,
        :PaymentInstrument,
        :PlatinumCreditCard,
        :PremiumCheckingAccount,
        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:BankClient a owl:Class ;
    rdfs:label "BankClient"^^xsd:string ;
    owl:disjointWith :BankPaymentCard,
        :CheckingAccount,
        :CollateralAppraised,
        :ContactlessDebitCard,
        :CreditAccount,
        :CreditCard,
        :DebitCard,
