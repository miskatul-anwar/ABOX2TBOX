        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:RegisteredNurse a owl:Class ;
    rdfs:label "RegisteredNurse"^^xsd:string ;
    rdfs:subClassOf :HealthcareStaff ;
    owl:disjointWith :SpecialistPhysician,
        :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:SurgicalPatient a owl:Class ;
    rdfs:label "SurgicalPatient"^^xsd:string ;
    rdfs:subClassOf :Inpatient ;
    owl:disjointWith :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:SpecialistPhysician a owl:Class ;
    rdfs:label "SpecialistPhysician"^^xsd:string ;
    rdfs:subClassOf :Physician ;
    owl:disjointWith :SurgicalPatient,
        :TriageLevelA,
        :TriageLevelB,
        :TriageLevelC .

:TriageLevelA a owl:Class ;
    rdfs:label "TriageLevelA"^^xsd:string .

:TriageLevelB a owl:Class ;
    rdfs:label "TriageLevelB"^^xsd:string .

:TriageLevelC a owl:Class ;
    rdfs:label "TriageLevelC"^^xsd:string .

