@prefix : <http://example.org/univ#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:UnivInducedOntology a owl:Ontology ;
    rdfs:label "Univ Domain Ontology"^^xsd:string .

:advises a owl:AsymmetricProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "advises"^^xsd:string ;
    rdfs:domain :AcademicStaff ;
    rdfs:range :GraduateStudent .

:advisor a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "advisor"^^xsd:string ;
    rdfs:domain :GraduateStudent ;
    rdfs:range :AcademicStaff .

:affiliatedDepartment a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "affiliatedDepartment"^^xsd:string ;
    rdfs:domain :LabAffiliated ;
    rdfs:range :AcademicUnit .

:authoredBy a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "authoredBy"^^xsd:string ;
    rdfs:domain :Publication ;
    rdfs:range :AcademicStaff .

:citesPublication a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "citesPublication"^^xsd:string ;
    rdfs:domain :Publication ;
    rdfs:range :Publication .

:collaboratesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaboratesWith"^^xsd:string ;
    rdfs:domain :AcademicStaff ;
    rdfs:range :AcademicStaff .

:conductsResearchIn a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "conductsResearchIn"^^xsd:string ;
    rdfs:domain :Person ;
    rdfs:range :LabAffiliated .

:conferredBy a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "conferredBy"^^xsd:string ;
    rdfs:domain :DegreeConferred ;
    rdfs:range :AcademicUnit .

:courseCredits a owl:DatatypeProperty ;
    rdfs:label "courseCredits"^^xsd:string .

:courseTitle a owl:DatatypeProperty ;
    rdfs:label "courseTitle"^^xsd:string .

:degreeLevel a owl:DatatypeProperty ;
    rdfs:label "degreeLevel"^^xsd:string .

:degreeTitle a owl:DatatypeProperty ;
    rdfs:label "degreeTitle"^^xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:label "email"^^xsd:string .

:employeeId a owl:DatatypeProperty ;
    rdfs:label "employeeId"^^xsd:string .

:endDate a owl:DatatypeProperty ;
    rdfs:label "endDate"^^xsd:string .

:enrolledInCourse a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "enrolledInCourse"^^xsd:string ;
    rdfs:domain :Person ;
    rdfs:range :Course .

:enrolledInDegree a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "enrolledInDegree"^^xsd:string ;
    rdfs:domain :Person ;
    rdfs:range :DegreeConferred .

:firstName a owl:DatatypeProperty ;
    rdfs:label "firstName"^^xsd:string .

:fundingAgency a owl:DatatypeProperty ;
    rdfs:label "fundingAgency"^^xsd:string .

:fundingAmount a owl:DatatypeProperty ;
    rdfs:label "fundingAmount"^^xsd:string .

:grantNumber a owl:DatatypeProperty ;
    rdfs:label "grantNumber"^^xsd:string .

:hasPrerequisite a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "hasPrerequisite"^^xsd:string ;
    rdfs:domain :Course ;
    rdfs:range :Course .

:hasTenure a owl:DatatypeProperty ;
    rdfs:label "hasTenure"^^xsd:string .

:headedBy a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "headedBy"^^xsd:string ;
    rdfs:domain :AcademicUnit ;
    rdfs:range :AcademicStaff .

:labDirector a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "labDirector"^^xsd:string ;
    rdfs:domain :LabAffiliated ;
    rdfs:range :AcademicStaff .

:labWebsite a owl:DatatypeProperty ;
    rdfs:label "labWebsite"^^xsd:string .

:lastName a owl:DatatypeProperty ;
    rdfs:label "lastName"^^xsd:string .

:locatedInRoom a owl:DatatypeProperty ;
    rdfs:label "locatedInRoom"^^xsd:string .

:memberOfDepartment a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "memberOfDepartment"^^xsd:string ;
    rdfs:domain :Employee ;
    rdfs:range :AcademicUnit .

:offeredBy a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "offeredBy"^^xsd:string ;
    rdfs:domain :DegreeConferred ;
    rdfs:range :AcademicUnit .

:officeRoom a owl:DatatypeProperty ;
    rdfs:label "officeRoom"^^xsd:string .

:principalInvestigator a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "principalInvestigator"^^xsd:string ;
    rdfs:domain :FundingGrant ;
    rdfs:range :AcademicStaff .

:publicationTitle a owl:DatatypeProperty ;
    rdfs:label "publicationTitle"^^xsd:string .

:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publicationYear"^^xsd:string .

:requiredCredits a owl:DatatypeProperty ;
    rdfs:label "requiredCredits"^^xsd:string .

:startDate a owl:DatatypeProperty ;
    rdfs:label "startDate"^^xsd:string .

:studentId a owl:DatatypeProperty ;
    rdfs:label "studentId"^^xsd:string .

:subDepartmentOf a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "subDepartmentOf"^^xsd:string ;
    rdfs:domain :AcademicUnit ;
    rdfs:range :AcademicUnit .

:supportedByGrant a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "supportedByGrant"^^xsd:string ;
    rdfs:domain :Publication ;
    rdfs:range :FundingGrant .

:teachesCourse a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "teachesCourse"^^xsd:string ;
    rdfs:domain :AcademicStaff ;
    rdfs:range :Course .

:unitName a owl:DatatypeProperty ;
    rdfs:label "unitName"^^xsd:string .

:AdjunctProfessor a owl:Class ;
    rdfs:label "AdjunctProfessor"^^xsd:string ;
    rdfs:subClassOf :FacultyMember ;
    owl:disjointWith :AdministrativeStaff,
        :AssistantProfessor,
        :AssociateProfessor,
        :ClericalStaff,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:AdministrativeStaff a owl:Class ;
    rdfs:label "AdministrativeStaff"^^xsd:string ;
    rdfs:subClassOf :Employee ;
    owl:disjointWith :AssistantProfessor,
        :AssociateProfessor,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor ;
    owl:equivalentClass :ClericalStaff .

:AssistantProfessor a owl:Class ;
    rdfs:label "AssistantProfessor"^^xsd:string ;
    rdfs:subClassOf :FacultyMember ;
    owl:disjointWith :AssociateProfessor,
        :ClericalStaff,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :TeachingAssistant,
        :UndergraduateCourse,
        :VisitingProfessor ;
    owl:equivalentClass :TenureTrackFaculty .

:AssociateProfessor a owl:Class ;
    rdfs:label "AssociateProfessor"^^xsd:string ;
    rdfs:subClassOf :TenuredFaculty ;
    owl:disjointWith :ClericalStaff,
        :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:ClericalStaff a owl:Class ;
    rdfs:label "ClericalStaff"^^xsd:string ;
    rdfs:subClassOf :Employee ;
    owl:disjointWith :ConferencePaper,
        :Course,
        :DegreeConferred,
        :Department,
        :Faculty,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:ConferencePaper a owl:Class ;
    rdfs:label "ConferencePaper"^^xsd:string ;
    rdfs:subClassOf :Publication ;
    owl:disjointWith :Course,
        :DegreeConferred,
        :Department,
        :Employee,
        :Faculty,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Organization,
        :Person,
        :PhDStudent,
        :PostdoctoralResearcher,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:Department a owl:Class ;
    rdfs:label "Department"^^xsd:string ;
    rdfs:subClassOf :AcademicUnit,
        :Organization ;
    owl:disjointWith :Employee,
        :Faculty,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
        :Lecturer,
        :MasterStudent,
        :Person,
        :PhDStudent,
        :PostdoctoralResearcher,
        :Publication,
        :ResearchInstitute,
        :Student,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:FullProfessor a owl:Class ;
    rdfs:label "FullProfessor"^^xsd:string ;
    rdfs:subClassOf :TenuredFaculty ;
    owl:disjointWith :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
