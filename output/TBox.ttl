@prefix : <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/smartcity> a owl:Ontology ;
    rdfs:label "Smartcity induced ontology" .

:aboxSupportCount a owl:AnnotationProperty .

:batteryLevelPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "batteryLevelPercentage" ;
    rdfs:domain :EnvironmentalSensor ;
    rdfs:range xsd:integer .

:communicatesMeshWith a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "communicatesMeshWith" ;
    rdfs:domain :EnvironmentalSensor ;
    rdfs:range :EnvironmentalSensor .

:confidenceScore a owl:AnnotationProperty .

:connectorStandard a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "connectorStandard" ;
    rdfs:domain :ConnectorStandard ;
    rdfs:range xsd:string .

:coolingSystemType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "coolingSystemType" ;
    rdfs:domain :ConnectorStandard ;
    rdfs:range xsd:string .

:cycleTimeSeconds a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cycleTimeSeconds" ;
    rdfs:domain :TrafficSignalController ;
    rdfs:range xsd:integer .

:decisionProbability a owl:AnnotationProperty .

:deviceName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "deviceName" ;
    rdfs:domain :PhysicalDevice ;
    rdfs:range xsd:string .

:deviceSerialIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "deviceSerialIdentifier" ;
    rdfs:domain :AirQualitySensor ;
    rdfs:range xsd:string .

:facilityIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "facilityIdentifier" ;
    rdfs:domain :PowerSubstation ;
    rdfs:range xsd:string .

:firmwareVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "firmwareVersion" ;
    rdfs:domain :EnvironmentalSensor ;
    rdfs:range xsd:string .

:fleetNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fleetNumber" ;
    rdfs:domain :MobilityAsset ;
    rdfs:range xsd:string .

:flightCeilingMeters a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "flightCeilingMeters" ;
    rdfs:domain :AutonomousAerialVehicle ;
    rdfs:range xsd:integer .

:frequencyBandsGHz a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "frequencyBandsGHz" ;
    rdfs:domain :RadarSpeedSensor ;
    rdfs:range xsd:decimal .

:generatesTelemetryRecord a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "generatesTelemetryRecord" ;
    rdfs:domain :AirQualitySensor ;
    rdfs:range :SignalStrength .

:hasChargingInterface a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasChargingInterface" ;
    rdfs:domain :DistributionSubstation ;
    rdfs:range :ConnectorStandard .

:hasMaintenanceRecord a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasMaintenanceRecord" ;
    rdfs:domain :TrafficSignalController ;
    rdfs:range :TechnicianNotes .

:inferenceLatencyMs a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "inferenceLatencyMs" ;
    rdfs:domain :TrafficFlowPredictor ;
    rdfs:range xsd:integer .

:installedInZone a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "installedInZone" ;
    rdfs:domain :PhysicalDevice ;
    rdfs:range :UrbanZone .

:loopSensitivity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "loopSensitivity" ;
    rdfs:domain :InductiveLoopSensor ;
    rdfs:range xsd:decimal .

:lumensOutput a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lumensOutput" ;
    rdfs:domain :SmartStreetLight ;
    rdfs:range xsd:integer .

:maximumChargeKW a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maximumChargeKW" ;
    rdfs:domain :ConnectorStandard ;
    rdfs:range xsd:integer .

:partOfGridSegment a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "partOfGridSegment" ;
    rdfs:domain :GridSegment ;
    rdfs:range :GridSegment .

:passengerCapacity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "passengerCapacity" ;
    rdfs:domain :AutonomousTransitShuttle ;
    rdfs:range xsd:integer .

:ratedPowerKW a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ratedPowerKW" ;
    rdfs:domain :RenewableEnergySource ;
    rdfs:range xsd:decimal .

:relaysDataTo a owl:ObjectProperty ;
    rdfs:label "relaysDataTo" ;
    rdfs:domain :GridSegment ;
    rdfs:range :GridSegment .

:sensorPrecisionScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sensorPrecisionScore" ;
    rdfs:domain :AirQualitySensor ;
    rdfs:range xsd:decimal .

:serviceEndpoint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "serviceEndpoint" ;
    rdfs:domain :DigitalService ;
    rdfs:range xsd:string .

:sharesPowerBusWith a owl:ObjectProperty ;
    rdfs:label "sharesPowerBusWith" ;
    rdfs:domain :GridInfrastructure ;
    rdfs:range :GridInfrastructure .

:signalStrengthDbm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "signalStrengthDbm" ;
    rdfs:domain :SignalStrength ;
    rdfs:range xsd:integer .

:storageCapacityMWh a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "storageCapacityMWh" ;
    rdfs:domain :BatteryEnergyStorage ;
    rdfs:range xsd:decimal .

:technicianNotes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "technicianNotes" ;
    rdfs:domain :TechnicianNotes ;
    rdfs:range xsd:string .

:telemetryPacketId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "telemetryPacketId" ;
    rdfs:domain :SignalStrength ;
    rdfs:range xsd:string .

:transmissionStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "transmissionStatus" ;
    rdfs:domain :SignalStrength ;
    rdfs:range xsd:string .

:urgencyPriorityScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "urgencyPriorityScore" ;
    rdfs:domain :TechnicianNotes ;
    rdfs:range xsd:integer .

:voltageRatingKV a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "voltageRatingKV" ;
    rdfs:domain :GridSubstation ;
    rdfs:range xsd:decimal .

:workOrderCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "workOrderCode" ;
    rdfs:domain :TechnicianNotes ;
    rdfs:range xsd:string .

:AcousticNoiseSensor a owl:Class ;
    rdfs:label "AcousticNoiseSensor" ;
    rdfs:subClassOf :EnvironmentalSensor ;
    owl:disjointWith :ActuatorDevice,
        :AirQualityForecaster,
        :AirQualitySensor,
        :AlertTierAlpha,
        :AlertTierBeta,
        :AlertTierGamma,
        :AnalyticsService,
        :AutonomousAerialVehicle,
        :AutonomousGroundVehicle,
        :AutonomousStreetSweeper,
        :AutonomousTransitShuttle,
        :AutonomousVehicle,
        :BatteryEnergyStorage,
        :DigitalService,
        :DistributionSubstation,
        :EmergencyAmbulance,
        :EmergencyDispatchService,
        :GridDispatchPlatform,
        :GridInfrastructure,
        :GridSegment,
        :GridSubstation,
        :HumanOperatedVehicle,
        :InductiveLoopSensor,
        :ManagementPlatform,
        :MobilityAsset,
        :MunicipalFleetTruck,
        :PowerSubstation,
        :RadarSpeedSensor,
        :RenewableEnergySource,
        :SmartStreetLight,
        :SolarPhotovoltaicArray,
        :SubstationFacility,
        :TrafficFlowPredictor,
        :TrafficSensor,
        :TrafficSignalController,
        :TransmissionSubstation,
        :UrbanWindTurbine .

:EmergencyDeliveryDrone a owl:Class ;
    rdfs:label "EmergencyDeliveryDrone" ;
    rdfs:subClassOf :AutonomousAerialVehicle .

:SurveillanceDrone a owl:Class ;
    rdfs:label "SurveillanceDrone" ;
    rdfs:subClassOf :AutonomousAerialVehicle .

:UrbanZone a owl:Class ;
    rdfs:label "UrbanZone" .

