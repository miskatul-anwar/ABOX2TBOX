        :TenuredFaculty,
        :UndergraduateCourse,
        :UndergraduateStudent,
        :VisitingProfessor .

:Faculty a owl:Class ;
    rdfs:label "Faculty"^^xsd:string ;
    rdfs:subClassOf :AcademicUnit,
        :Organization ;
    owl:disjointWith :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
        :LabAffiliated,
