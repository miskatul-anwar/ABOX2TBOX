        :OfficeFacility,
        :PerformanceReview,
        :ProjectMilestoneA,
        :ProjectMilestoneB,
        :ProjectMilestoneC,
        :ServerAsset,
        :StaffMember,
        :WorkstationAsset .

:EnterpriseAsset a owl:Class ;
