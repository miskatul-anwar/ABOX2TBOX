        :GridSubstation,
        :HumanOperatedVehicle,
        :InductiveLoopSensor,
        :ManagementPlatform,
        :MobilityAsset,
        :MunicipalFleetTruck,
        :PowerSubstation,
        :RadarSpeedSensor,
        :RenewableEnergySource,
        :SmartStreetLight,
        :SolarPhotovoltaicArray,
        :SubstationFacility,
        :SurveillanceDrone,
        :TechnicianNotes,
        :TelemetrySignal,
        :TrafficFlowPredictor,
        :TrafficSensor,
        :TrafficSignalController,
        :TransmissionSubstation,
        :UrbanWindTurbine,
        :UrbanZone .

