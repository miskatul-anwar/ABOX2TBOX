:CollateralAppraised a owl:Class ;
    rdfs:label "CollateralAppraised"^^xsd:string ;
    owl:disjointWith :ContactlessDebitCard,
        :CreditAccount,
        :CreditCard,
        :DebitCard,
        :DepositoryAccount,
        :FeeSchedule,
        :FinancialAccount,
