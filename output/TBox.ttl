@prefix ns1: <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:AirQualityForecaster a owl:Class ;
    rdfs:label "AirQualityForecaster" .

ns1:AlertTierBeta a owl:Class ;
    rdfs:label "AlertTierBeta" ;
    owl:disjointWith ns1:DigitalService,
        ns1:GridInfrastructure,
        ns1:GridSubstation .

ns1:AlertTierGamma a owl:Class ;
    rdfs:label "AlertTierGamma" ;
    owl:disjointWith ns1:GridSegment .

ns1:AnalyticsService a owl:Class ;
    rdfs:label "AnalyticsService" ;
    owl:disjointWith ns1:HumanOperatedVehicle .

ns1:EmergencyDispatchService a owl:Class ;
    rdfs:label "EmergencyDispatchService" .

ns1:ManagementPlatform a owl:Class ;
    rdfs:label "ManagementPlatform" .

ns1:MaximumChargeKwEntity a owl:Class ;
    rdfs:label "MaximumChargeKwEntity" ;
    ns1:competencyQuestion "What is the maximum charging power in kilowatts (KW) for a given electric vehicle charging station, and what type of cooling system does it use, along with the standard of the connector used?" ;
    rdfs:comment "A class representing the characteristics of an electric vehicle charging station, including its maximum charging power, cooling system type, and connector standard." .

ns1:Ontology a owl:Ontology ;
    rdfs:label "Core induced ontology (v3.0 Clef-Flash)" ;
    prov:wasAttributedTo "clef-flash:latest" .

ns1:Telemetrypacket a owl:Class ;
    rdfs:label "Telemetrypacket" ;
    ns1:competencyQuestion "What is the signal strength in dBm for a specific telemetry packet, and what is the transmission status of that packet?" ;
    rdfs:comment "TelemetryPacket represents a data packet containing information about signal strength and transmission status." .

ns1:batteryLevelPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "batteryLevelPercentage" ;
    rdfs:domain ns1:EnvironmentalSensor .

ns1:connectorStandard a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "connectorStandard" .

ns1:coolingSystemType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "coolingSystemType" .

ns1:cycleTimeSeconds a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cycleTimeSeconds" ;
    rdfs:domain ns1:TrafficSignalController .

ns1:deviceName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "deviceName" ;
    rdfs:domain ns1:PhysicalDevice .

ns1:deviceSerialIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "deviceSerialIdentifier" ;
    rdfs:domain ns1:AirQualitySensor .

ns1:facilityIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "facilityIdentifier" ;
    rdfs:domain ns1:PowerSubstation .

ns1:firmwareVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "firmwareVersion" ;
    rdfs:domain ns1:EnvironmentalSensor .

ns1:fleetNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "fleetNumber" ;
    rdfs:domain ns1:MobilityAsset .

ns1:flightCeilingMeters a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "flightCeilingMeters" ;
    rdfs:domain ns1:AutonomousAerialVehicle .

ns1:frequencyBandsGHz a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "frequencyBandsGHz" ;
    rdfs:domain ns1:RadarSpeedSensor .

ns1:inferenceLatencyMs a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "inferenceLatencyMs" ;
    rdfs:domain ns1:TrafficFlowPredictor .

ns1:loopSensitivity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "loopSensitivity" ;
    rdfs:domain ns1:InductiveLoopSensor .

ns1:lumensOutput a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lumensOutput" ;
    rdfs:domain ns1:SmartStreetLight .

ns1:maximumChargeKW a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maximumChargeKW" .

ns1:partOfGridSegment a owl:ObjectProperty ;
    rdfs:label "partOfGridSegment" ;
    rdfs:domain ns1:GridSegment ;
    rdfs:range ns1:GridSegment .

ns1:passengerCapacity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "passengerCapacity" ;
    rdfs:domain ns1:AutonomousTransitShuttle .

ns1:ratedPowerKW a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ratedPowerKW" ;
    rdfs:domain ns1:RenewableEnergySource .

ns1:relaysDataTo a owl:ObjectProperty ;
    rdfs:label "relaysDataTo" ;
    rdfs:domain ns1:GridSegment ;
    rdfs:range ns1:GridSegment .

ns1:sensorPrecisionScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sensorPrecisionScore" ;
    rdfs:domain ns1:AirQualitySensor .

ns1:serviceEndpoint a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "serviceEndpoint" ;
    rdfs:domain ns1:DigitalService .

ns1:signalStrengthDbm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "signalStrengthDbm" .

ns1:storageCapacityMWh a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "storageCapacityMWh" ;
    rdfs:domain ns1:BatteryEnergyStorage .

ns1:technicianNotes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "technicianNotes" ;
    rdfs:domain ns1:Workorder .

ns1:telemetryPacketId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "telemetryPacketId" .

ns1:transmissionStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "transmissionStatus" .

ns1:urgencyPriorityScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "urgencyPriorityScore" ;
    rdfs:domain ns1:Workorder .

ns1:voltageRatingKV a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "voltageRatingKV" ;
    rdfs:domain ns1:GridSubstation .

ns1:workOrderCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "workOrderCode" ;
    rdfs:domain ns1:Workorder .

ns1:AlertTierAlpha a owl:Class ;
    rdfs:label "AlertTierAlpha" ;
    owl:disjointWith ns1:GridDispatchPlatform .

ns1:BatteryEnergyStorage a owl:Class ;
    rdfs:label "BatteryEnergyStorage" ;
    owl:disjointWith ns1:TrafficFlowPredictor,
        ns1:TrafficSignalController,
        ns1:Workorder .

ns1:GridDispatchPlatform a owl:Class ;
    rdfs:label "GridDispatchPlatform" .

ns1:PowerSubstation a owl:Class ;
    rdfs:label "PowerSubstation" ;
    owl:equivalentClass ns1:SubstationFacility .

ns1:TransmissionSubstation a owl:Class ;
    rdfs:label "TransmissionSubstation" .

ns1:generatesTelemetryRecord a owl:ObjectProperty ;
    rdfs:label "generatesTelemetryRecord" ;
    rdfs:domain ns1:AirQualitySensor ;
    rdfs:range ns1:Telemetryrecord .

ns1:hasChargingInterface a owl:ObjectProperty ;
    rdfs:label "hasChargingInterface" ;
    rdfs:domain ns1:DistributionSubstation ;
    rdfs:range ns1:Charginginterfacetype .

ns1:hasMaintenanceRecord a owl:ObjectProperty ;
    rdfs:label "hasMaintenanceRecord" ;
    rdfs:domain ns1:TrafficSignalController ;
    rdfs:range ns1:Workorder .

ns1:sharesPowerBusWith a owl:ObjectProperty ;
    rdfs:label "sharesPowerBusWith" ;
    rdfs:domain ns1:GridInfrastructure ;
    rdfs:range ns1:GridInfrastructure .

ns1:AcousticNoiseSensor a owl:Class ;
    rdfs:label "AcousticNoiseSensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AcousticNoiseSensor linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AcousticNoiseSensor linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of AcousticNoiseSensor linked via communicatesMeshWith has only fillers of type AirQualitySensor" ;
            owl:allValuesFrom ns1:AirQualitySensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AcousticNoiseSensor linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of AcousticNoiseSensor is linked via communicatesMeshWith to at least one instance of AirQualitySensor" ;
            owl:onProperty ns1:communicatesMeshWith ;
            owl:someValuesFrom ns1:AirQualitySensor ] ;
    owl:disjointWith ns1:AlertTierAlpha .

ns1:ActuatorDevice a owl:Class ;
    rdfs:label "ActuatorDevice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of ActuatorDevice linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        ns1:PhysicalDevice .

ns1:AutonomousGroundVehicle a owl:Class ;
    rdfs:label "AutonomousGroundVehicle" ;
    rdfs:subClassOf ns1:AutonomousVehicle .

ns1:AutonomousStreetSweeper a owl:Class ;
    rdfs:label "AutonomousStreetSweeper" ;
    rdfs:subClassOf ns1:AutonomousVehicle .

ns1:Charginginterfacetype a owl:Class ;
    rdfs:label "Charginginterfacetype" ;
    ns1:competencyQuestion "What is the type of charging interface and its associated maximum charging power and cooling system for a given electric vehicle connector standard?" ;
    rdfs:comment "ElectricVehicleConnector is a class that defines the type of charging interface, its maximum charging power, and cooling system." .

ns1:DigitalService a owl:Class ;
    rdfs:label "DigitalService" ;
    owl:disjointWith ns1:GridSegment,
        ns1:HumanOperatedVehicle .

ns1:EmergencyAmbulance a owl:Class ;
    rdfs:label "EmergencyAmbulance" ;
    rdfs:subClassOf ns1:HumanOperatedVehicle .

ns1:EmergencyDeliveryDrone a owl:Class ;
    rdfs:label "EmergencyDeliveryDrone" ;
    rdfs:subClassOf ns1:MobilityAsset .

ns1:SolarPhotovoltaicArray a owl:Class ;
    rdfs:label "SolarPhotovoltaicArray" ;
    rdfs:subClassOf ns1:RenewableEnergySource .

ns1:SurveillanceDrone a owl:Class ;
    rdfs:label "SurveillanceDrone" ;
    rdfs:subClassOf ns1:MobilityAsset .

ns1:Telemetryrecord a owl:Class ;
    rdfs:label "Telemetryrecord" ;
    ns1:competencyQuestion "What is the signal strength in decibel-milliwatts (dBm) of a telemetry packet with a specific packet ID, and what is the transmission status of this packet?" ;
    rdfs:comment "TelemetryRecord captures the signal strength, packet ID, and transmission status of a communication packet." .

ns1:TrafficFlowPredictor a owl:Class ;
    rdfs:label "TrafficFlowPredictor" .

ns1:TrafficSensor a owl:Class ;
    rdfs:label "TrafficSensor" ;
    rdfs:subClassOf ns1:SmartCityAsset .

ns1:UrbanWindTurbine a owl:Class ;
    rdfs:label "UrbanWindTurbine" ;
    rdfs:subClassOf ns1:RenewableEnergySource .

ns1:AutonomousAerialVehicle a owl:Class ;
    rdfs:label "AutonomousAerialVehicle" ;
    rdfs:subClassOf ns1:MobilityAsset ;
    owl:disjointWith ns1:MunicipalFleetTruck .

ns1:AutonomousTransitShuttle a owl:Class ;
    rdfs:label "AutonomousTransitShuttle" ;
    rdfs:subClassOf ns1:AutonomousVehicle .

ns1:DistributionSubstation a owl:Class ;
    rdfs:label "DistributionSubstation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7.1e-01 ;
            rdfs:comment "Every instance of DistributionSubstation is linked via hasChargingInterface to at least one instance of Charginginterfacetype" ;
            owl:onProperty ns1:hasChargingInterface ;
            owl:someValuesFrom ns1:Charginginterfacetype ],
        ns1:GridSubstation .

ns1:InductiveLoopSensor a owl:Class ;
    rdfs:label "InductiveLoopSensor" ;
    rdfs:subClassOf ns1:PhysicalDevice .

ns1:MunicipalFleetTruck a owl:Class ;
    rdfs:label "MunicipalFleetTruck" ;
    rdfs:subClassOf ns1:MobilityAsset .

ns1:RadarSpeedSensor a owl:Class ;
    rdfs:label "RadarSpeedSensor" ;
    rdfs:subClassOf ns1:SensorDevice .

ns1:SmartStreetLight a owl:Class ;
    rdfs:label "SmartStreetLight" ;
    rdfs:subClassOf ns1:SmartCityAsset .

ns1:SubstationFacility a owl:Class ;
    rdfs:label "SubstationFacility" .

ns1:GridInfrastructure a owl:Class ;
    rdfs:label "GridInfrastructure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of GridInfrastructure linked via sharesPowerBusWith has only fillers of type GridInfrastructure" ;
            owl:allValuesFrom ns1:GridInfrastructure ;
            owl:onProperty ns1:sharesPowerBusWith ] .

ns1:SensorDevice a owl:Class ;
    rdfs:label "SensorDevice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SensorDevice linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SensorDevice linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SensorDevice linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SensorDevice linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ] .

ns1:TrafficSignalController a owl:Class ;
    rdfs:label "TrafficSignalController" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of TrafficSignalController linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        [ a owl:Restriction ;
            ns1:celoeScore 1.01e+00 ;
            rdfs:comment "Every instance of TrafficSignalController is linked via hasMaintenanceRecord to at least one instance of Workorder" ;
            owl:onProperty ns1:hasMaintenanceRecord ;
            owl:someValuesFrom ns1:Workorder ] .

ns1:GridSubstation a owl:Class ;
    rdfs:label "GridSubstation" .

ns1:GridSegment a owl:Class ;
    rdfs:label "GridSegment" ;
    owl:disjointWith ns1:HumanOperatedVehicle .

ns1:HumanOperatedVehicle a owl:Class ;
    rdfs:label "HumanOperatedVehicle" ;
    owl:disjointWith ns1:SubstationFacility,
        ns1:TransmissionSubstation .

ns1:AirQualitySensor a owl:Class ;
    rdfs:label "AirQualitySensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 9.01e-01 ;
            rdfs:comment "Every instance of AirQualitySensor is linked via generatesTelemetryRecord to at least one instance of Telemetryrecord" ;
            owl:onProperty ns1:generatesTelemetryRecord ;
            owl:someValuesFrom ns1:Telemetryrecord ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor is linked via communicatesMeshWith to at least one instance of AcousticNoiseSensor" ;
            owl:onProperty ns1:communicatesMeshWith ;
            owl:someValuesFrom ns1:AcousticNoiseSensor ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via communicatesMeshWith has only fillers of type SensorDevice" ;
            owl:allValuesFrom ns1:SensorDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7.7e-01 ;
            rdfs:comment "Every instance of AirQualitySensor linked via communicatesMeshWith has only fillers of type AcousticNoiseSensor" ;
            owl:allValuesFrom ns1:AcousticNoiseSensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        ns1:EnvironmentalSensor .

ns1:RenewableEnergySource a owl:Class ;
    rdfs:label "RenewableEnergySource" .

ns1:Workorder a owl:Class ;
    rdfs:label "Workorder" ;
    ns1:competencyQuestion "What is the urgency priority score and maintenance record associated with a work order, and what notes does the technician have for this work order?" ;
    rdfs:comment "WorkOrder is a record of a maintenance task characterized by its urgency priority score, associated maintenance record, and technician notes." .

ns1:installedInZone a owl:ObjectProperty ;
    rdfs:label "installedInZone" ;
    rdfs:domain ns1:PhysicalDevice ;
    rdfs:range ns1:UrbanZone .

ns1:UrbanZone a owl:Class ;
    rdfs:label "UrbanZone" .

ns1:AutonomousVehicle a owl:Class ;
    rdfs:label "AutonomousVehicle" ;
    rdfs:subClassOf ns1:MobilityAsset .

ns1:SmartCityAsset a owl:Class ;
    rdfs:label "SmartCityAsset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SmartCityAsset linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SmartCityAsset linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SmartCityAsset linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of SmartCityAsset linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ] .

ns1:EnvironmentalSensor a owl:Class ;
    rdfs:label "EnvironmentalSensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of EnvironmentalSensor linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of EnvironmentalSensor linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of EnvironmentalSensor linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of EnvironmentalSensor linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        ns1:PhysicalDevice .

ns1:MobilityAsset a owl:Class ;
    rdfs:label "MobilityAsset" ;
    owl:disjointWith ns1:SubstationFacility,
        ns1:TrafficSignalController,
        ns1:Workorder .

ns1:PhysicalDevice a owl:Class ;
    rdfs:label "PhysicalDevice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalDevice linked via communicatesMeshWith has only fillers of type SmartCityAsset" ;
            owl:allValuesFrom ns1:SmartCityAsset ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalDevice linked via communicatesMeshWith has only fillers of type EnvironmentalSensor" ;
            owl:allValuesFrom ns1:EnvironmentalSensor ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalDevice linked via communicatesMeshWith has only fillers of type PhysicalDevice" ;
            owl:allValuesFrom ns1:PhysicalDevice ;
            owl:onProperty ns1:communicatesMeshWith ],
        [ a owl:Restriction ;
            ns1:celoeScore 7e-01 ;
            rdfs:comment "Every instance of PhysicalDevice linked via installedInZone has only fillers of type UrbanZone" ;
            owl:allValuesFrom ns1:UrbanZone ;
            owl:onProperty ns1:installedInZone ] .

ns1:communicatesMeshWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "communicatesMeshWith" ;
    rdfs:domain ns1:EnvironmentalSensor ;
    rdfs:range ns1:EnvironmentalSensor .

[] a rdf:Statement,
        owl:Axiom ;
    ns1:aboxSupportCount 18 ;
    ns1:confidenceScore 9.24e-01 ;
    ns1:decisionProbability 9.48e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 2.191e+00 ;
    rdf:object ns1:MobilityAsset ;
    rdf:predicate rdfs:subClassOf ;
    rdf:subject ns1:AutonomousVehicle ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ns1:AutonomousVehicle ;
    owl:annotatedTarget ns1:MobilityAsset ;
    prov:wasAttributedTo "clef-flash:latest" .

[] a rdf:Statement,
        owl:Axiom ;
    ns1:aboxSupportCount 5 ;
    ns1:confidenceScore 8.51e-01 ;
    ns1:decisionProbability 9.62e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 1.992e+00 ;
    rdf:object ns1:MobilityAsset ;
    rdf:predicate rdfs:subClassOf ;
    rdf:subject ns1:MunicipalFleetTruck ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ns1:MunicipalFleetTruck ;
    owl:annotatedTarget ns1:MobilityAsset ;
    prov:wasAttributedTo "clef-flash:latest" .

[] a rdf:Statement,
        owl:Axiom ;
    ns1:aboxSupportCount 4 ;
    ns1:confidenceScore 7.29e-01 ;
    ns1:decisionProbability 9.58e-01 ;
    ns1:miningMode "extensional" ;
    ns1:ontologicalNecessityScore 1.929e+00 ;
    rdf:object ns1:HumanOperatedVehicle ;
    rdf:predicate rdfs:subClassOf ;
    rdf:subject ns1:EmergencyAmbulance ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ns1:EmergencyAmbulance ;
    owl:annotatedTarget ns1:HumanOperatedVehicle ;
    prov:wasAttributedTo "clef-flash:latest" .

[] a rdf:Statement,
        owl:Axiom ;
