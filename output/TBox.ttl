        :ResearchInstitute,
        :TeachingAssistant,
        :TenureTrackFaculty,
        :UndergraduateCourse,
        :VisitingProfessor .

:DegreeConferred a owl:Class ;
    rdfs:label "DegreeConferred"^^xsd:string ;
    owl:disjointWith :Department,
        :Employee,
        :Faculty,
        :FacultyMember,
        :FullProfessor,
        :FundingGrant,
        :GraduateCourse,
        :GraduateStudent,
        :Instructor,
        :JournalArticle,
