        :RiskRatingTierA,
        :RiskRatingTierB,
        :RiskRatingTierC,
        :SavingsAccount,
        :StudentCheckingAccount,
        :TokenSecurity .

:BankBranch a owl:Class ;
    rdfs:label "BankBranch"^^xsd:string ;
    owl:disjointWith :BankClient,
        :BankPaymentCard,
        :CheckingAccount,
        :CollateralAppraised,
        :ContactlessDebitCard,
        :CreditAccount,
        :CreditCard,
        :DebitCard,
